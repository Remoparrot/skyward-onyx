+/// The browser's own style for an element, before the page's rules.
+pub fn defaults(doc: &Document, node: usize, parent: &Style, style: &mut Style) {
+    let tag = doc.nodes[node].tag.as_str();
+    style.font_px = parent.font_px;
+    style.color = parent.color;
+    style.underline = parent.underline;
+    style.align = parent.align;
+    style.line_height = parent.line_height;
+    style.pre = parent.pre;
+    let em = style.font_px;
+    match tag {
+        "html" | "body" => {
+            style.display = Display::Block;
+            style.margin = [8.0, 8.0, 8.0, 8.0];
+            if tag == "body" {
+                style.body = true;
+            }
+        }
+        "div" | "p" | "ul" | "ol" | "li" | "dl" | "dt" | "dd" | "table" | "tr" | "thead" | "tbody" | "tfoot" | "section"
+        | "article" | "header" | "footer" | "nav" | "main" | "aside" | "figure" | "figcaption" | "form" | "fieldset"
+        | "blockquote" | "pre" | "address" | "center" | "hr" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "details"
+        | "summary" | "caption" | "td" | "th" | "colgroup" | "option" => style.display = Display::Block,
+        _ => style.display = Display::Inline,
+    }
+    match tag {
+        "p" => style.margin = [em * 1.0, 0.0, em * 1.0, 0.0],
+        "blockquote" => style.margin = [em * 1.0, 40.0, em * 1.0, 40.0],
+        "h1" => {
+            style.font_px = em * 2.0;
+            style.weight = 700;
+            style.margin = [em * 0.67, 0.0, em * 0.67, 0.0];
+        }
+        "h2" => {
+            style.font_px = em * 1.5;
+            style.weight = 700;
+            style.margin = [em * 0.83, 0.0, em * 0.83, 0.0];
+        }
+        "h3" => {
+            style.font_px = em * 1.17;
+            style.weight = 700;
+            style.margin = [em * 1.0, 0.0, em * 1.0, 0.0];
+        }
+        "h4" => {
+            style.font_px = em * 1.0;
+            style.weight = 700;
+            style.margin = [em * 1.33, 0.0, em * 1.33, 0.0];
+        }
+        "h5" => {
+            style.font_px = em * 0.83;
+            style.weight = 700;
+            style.margin = [em * 1.67, 0.0, em * 1.67, 0.0];
+        }
+        "h6" => {
+            style.font_px = em * 0.67;
+            style.weight = 700;
+            style.margin = [em * 2.33, 0.0, em * 2.33, 0.0];
+        }
+        "b" | "strong" | "th" => style.weight = 700,
+        "i" | "em" | "cite" | "var" | "dfn" | "address" => style.weight = 500,
+        "small" => style.font_px = em * 0.83,
+        "big" => style.font_px = em * 1.2,
+        "code" | "kbd" | "samp" | "tt" => style.pre = false,
+        "pre" => {
+            style.pre = true;
+            style.margin = [em * 1.0, 0.0, em * 1.0, 0.0];
+        }
+        "ul" | "ol" | "menu" | "dir" => {
+            style.margin = [em * 1.0, 0.0, em * 1.0, 0.0];
+            style.padding = [0.0, 0.0, 0.0, em * 2.0];
+            style.list = if tag == "ol" { List::Decimal } else { List::Disc };
+        }
+        "li" => {
+            // A list item that holds blocks is a box of its own, as search
+            // results are, and is given no bullet.
+            let holds_blocks = doc.nodes[node].children.iter().any(|&c| is_block_tag(&doc.nodes[c].tag));
+            style.list = if holds_blocks {
+                List::None
+            } else if parent.list == List::Decimal {
+                List::Decimal
+            } else {
+                List::Disc
+            };
+            style.margin = [em * 0.25, 0.0, em * 0.25, 0.0];
+            if style.list != List::None {
+                style.padding[3] = style.padding[3].max(em * 1.2);
+            }
+        }
+        "center" => style.align = Align::Center,
+        "hr" => {
+            style.margin = [em * 0.5, 0.0, em * 0.5, 0.0];
+            style.border_bottom = Some(Rgba::rgb(0xcc, 0xcc, 0xcc));
+        }
+        "a" => {
+            if doc.has_attr(node, "href") {
+                style.color = Rgba::rgb(0x1a, 0x0d, 0xab);
+                style.underline = false;
+                style.href = doc.attr(node, "href").map(|s| s.to_string());
+            }
+        }
+        "img" => style.display = Display::Inline,
+        "br" => style.display = Display::Inline,
+        "script" | "style" | "head" | "title" | "meta" | "link" | "base" | "noscript" | "template" | "iframe" | "svg"
+        | "canvas" | "video" | "audio" | "object" | "embed" | "input" | "select" | "textarea" | "button" => {
+            style.display = Display::None
+        }
+        _ => {}
+    }
+    if style.list != List::None {
+        style.padding[3] = style.padding[3].max(em * 1.2);
+    }
+}
