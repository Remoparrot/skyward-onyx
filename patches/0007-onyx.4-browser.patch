+//! What the browser makes of a page's CSS: which declarations apply to
+//! which element, and what the browser's own defaults are for him.
+//!
+//! A subset of CSS, chosen for what pages draw text with: the display
+//! type, colours, sizes, margins, padding, alignment and lists. Flex and
+//! grid are laid out as blocks, which is what a page without them looks
+//! like anyway.
+
+use super::html::Document;
+use crate::color::Rgba;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Display {
+    #[default]
+    Inline,
+    Block,
+    None,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Align {
+    #[default]
+    Left,
+    Center,
+    Right,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum List {
+    None,
+    Disc,
+    Decimal,
+}
+
+impl Default for List {
+    fn default() -> Self {
+        List::None
+    }
+}
+
+/// An element's style, as the browser computes it: lengths are already in
+/// CSS pixels, fonts in the size the text is drawn at.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Style {
+    pub display: Display,
+    pub color: Rgba,
+    pub bg: Option<Rgba>,
+    /// The em size of the element's text, in CSS pixels.
+    pub font_px: f32,
+    pub weight: u16,
+    pub underline: bool,
+    pub align: Align,
+    /// Top, right, bottom, left, in CSS pixels.
+    pub margin: [f32; 4],
+    pub padding: [f32; 4],
+    /// Line height, as a multiple of the em size.
+    pub line_height: f32,
+    pub pre: bool,
+    pub list: List,
+    pub width: Option<f32>,
+    pub border_bottom: Option<Rgba>,
+    /// Whether the element is a link and where to.
+    pub href: Option<String>,
+    /// The page's body, which fills the page whatever it holds.
+    pub body: bool,
+}
+
+impl Style {
+    pub fn root() -> Style {
+        Style {
+            display: Display::Block,
+            color: Rgba::rgb(0x20, 0x20, 0x20),
+            bg: None,
+            font_px: 16.0,
+            weight: 400,
+            underline: false,
+            align: Align::Left,
+            margin: [0.0; 4],
+            padding: [0.0; 4],
+            line_height: 1.42,
+            pre: false,
+            list: List::None,
+            width: None,
+            border_bottom: None,
+            href: None,
+            body: false,
+        }
+    }
+}
+
+/// A stylesheet: the rules a page carries in `<style>` and in its `style`
+/// attributes.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Sheet {
+    pub rules: Vec<Rule>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Rule {
+    pub selectors: Vec<Selector>,
+    pub decls: Vec<(String, String)>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Selector {
+    pub parts: Vec<Part>,
+    pub specificity: u32,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Part {
+    pub combinator: Combinator,
+    pub compound: Compound,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Combinator {
+    Descendant,
+    Child,
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Compound {
+    pub tag: Option<String>,
+    pub id: Option<String>,
+    pub classes: Vec<String>,
+    pub any: bool,
+}
+
+impl Compound {
+    fn matches(&self, doc: &Document, node: usize) -> bool {
+        let Some(entry) = doc.nodes.get(node) else { return false };
+        if entry.tag.is_empty() {
+            return false;
+        }
+        if let Some(tag) = &self.tag {
+            if entry.tag != *tag {
+                return false;
+            }
+        }
+        if self.any || (self.tag.is_none() && self.id.is_none() && self.classes.is_empty()) {
+            return true;
+        }
+        if let Some(id) = &self.id {
+            if doc.attr(node, "id") != Some(id.as_str()) {
+                return false;
+            }
+        }
+        if !self.classes.is_empty() {
+            let classes = doc.attr(node, "class").unwrap_or("");
+            for want in &self.classes {
+                if !classes.split_ascii_whitespace().any(|c| c == want) {
+                    return false;
+                }
+            }
+        }
+        true
+    }
+}
+
+impl Selector {
+    pub fn matches(&self, doc: &Document, node: usize) -> bool {
+        if doc.nodes.get(node).is_none_or(|n| n.tag.is_empty()) {
+            return false;
+        }
+        self.matches_from(doc, node, self.parts.len())
+    }
+
+    fn matches_from(&self, doc: &Document, node: usize, upto: usize) -> bool {
+        if upto == 0 {
+            return true;
+        }
+        let part = &self.parts[upto - 1];
+        if !part.compound.matches(doc, node) {
+            return false;
+        }
+        if upto == 1 {
+            return true;
+        }
+        let parent = doc.nodes[node].parent;
+        if parent == node {
+            return false;
+        }
+        match part.combinator {
+            Combinator::Child => self.matches_from(doc, parent, upto - 1),
+            Combinator::Descendant => {
+                let mut at = parent;
+                loop {
+                    if self.matches_from(doc, at, upto - 1) {
+                        return true;
+                    }
+                    let up = doc.nodes[at].parent;
+                    if up == at {
+                        return false;
+                    }
+                    at = up;
+                }
+            }
+        }
+    }
+}
+
+impl Sheet {
+    /// Parse the rules of a stylesheet.
+    pub fn parse(css: &str) -> Sheet {
+        let css = strip_comments(css);
+        let mut rules = Vec::new();
+        let mut i = 0;
+        let bytes = css.as_bytes();
+        while i < bytes.len() {
+            while i < bytes.len() && bytes[i].is_ascii_whitespace() {
+                i += 1;
+            }
+            let Some(open) = css[i..].find('{') else { break };
+            let head = css[i..i + open].trim().to_string();
+            let Some(close) = matching_brace(&css, i + open) else { break };
+            let body = &css[i + open + 1..close];
+            i = close + 1;
+            if head.starts_with('@') {
+                continue;
+            }
+            let selectors: Vec<Selector> = head.split(',').filter_map(|s| parse_selector(s.trim())).collect();
+            if selectors.is_empty() {
+                continue;
+            }
+            let decls = parse_decls(body);
+            if decls.is_empty() {
+                continue;
+            }
+            rules.push(Rule { selectors, decls });
+        }
+        Sheet { rules }
+    }
+}
+
+fn strip_comments(css: &str) -> String {
+    let mut out = String::with_capacity(css.len());
+    let mut rest = css;
+    while let Some(at) = rest.find("/*") {
+        out.push_str(&rest[..at]);
+        match rest[at + 2..].find("*/") {
+            Some(end) => rest = &rest[at + 2 + end + 2..],
+            None => {
+                rest = "";
+                break;
+            }
+        }
+    }
+    out.push_str(rest);
+    out
+}
+
+fn matching_brace(css: &str, open: usize) -> Option<usize> {
+    let bytes = css.as_bytes();
+    let mut depth = 0;
+    let mut i = open;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'{' => depth += 1,
+            b'}' => {
+                depth -= 1;
+                if depth == 0 {
+                    return Some(i);
+                }
+            }
+            b'"' | b'\'' => {
+                let quote = bytes[i];
+                i += 1;
+                while i < bytes.len() && bytes[i] != quote {
+                    i += 1;
+                }
+            }
+            _ => {}
+        }
+        i += 1;
+    }
+    None
+}
+
+/// The declarations of a rule block, each property lowercased.
+pub fn parse_decls(body: &str) -> Vec<(String, String)> {
+    let mut out = Vec::new();
+    let mut depth = 0i32;
+    let mut start = 0;
+    let mut i = 0;
+    let bytes = body.as_bytes();
+    while i < bytes.len() {
+        match bytes[i] {
+            b'(' => depth += 1,
+            b')' => depth -= 1,
+            b'"' | b'\'' => {
+                let quote = bytes[i];
+                i += 1;
+                while i < bytes.len() && bytes[i] != quote {
+                    i += 1;
+                }
+            }
+            b';' if depth == 0 => {
+                push_decl(&body[start..i], &mut out);
+                start = i + 1;
+            }
+            _ => {}
+        }
+        i += 1;
+    }
+    push_decl(&body[start..], &mut out);
+    out
+}
+
+fn push_decl(text: &str, out: &mut Vec<(String, String)>) {
+    let Some(colon) = text.find(':') else { return };
+    let prop = text[..colon].trim().to_ascii_lowercase();
+    let value = text[colon + 1..].trim().trim_end_matches("!important").trim().to_string();
+    if prop.is_empty() || value.is_empty() {
+        return;
+    }
+    // The last one of a property wins.
+    out.retain(|(p, _)| *p != prop);
+    out.push((prop, value));
+}
+
+fn parse_selector(text: &str) -> Option<Selector> {
+    if text.is_empty() {
+        return None;
+    }
+    if text.contains("::before") || text.contains("::after") || text.contains(":before") || text.contains(":after") {
+        return None;
+    }
+    let mut parts = Vec::new();
+    let mut combinator = Combinator::Descendant;
+    let mut ids = 0u32;
+    let mut classes = 0u32;
+    let mut tags = 0u32;
+    let mut i = 0;
+    let bytes = text.as_bytes();
+    while i < bytes.len() {
+        let b = bytes[i];
+        if b.is_ascii_whitespace() {
+            combinator = Combinator::Descendant;
+            i += 1;
+            continue;
+        }
+        if b == b'>' {
+            combinator = Combinator::Child;
+            i += 1;
+            continue;
+        }
+        if b == b'+' || b == b'~' {
+            combinator = Combinator::Descendant;
+            i += 1;
+            continue;
+        }
+        let mut compound = Compound::default();
+        while i < bytes.len() {
+            let b = bytes[i];
+            if b.is_ascii_whitespace() || b == b'>' || b == b'+' || b == b'~' {
+                break;
+            }
+            match b {
+                b'#' => {
+                    let (name, next) = read_name(text, i + 1);
+                    compound.id = Some(name);
+                    ids += 1;
+                    i = next;
+                }
+                b'.' => {
+                    let (name, next) = read_name(text, i + 1);
+                    compound.classes.push(name);
+                    classes += 1;
+                    i = next;
+                }
+                b':' => {
+                    // A pseudo-class is taken as no condition at all.
+                    let (name, next) = read_name(text, i + 1);
+                    if name == "not" || name.is_empty() {
+                        // Skip a parenthesised condition.
+                        if text[next..].starts_with('(') {
+                            let mut depth = 0;
+                            let mut j = next;
+                            while j < bytes.len() {
+                                match bytes[j] {
+                                    b'(' => depth += 1,
+                                    b')' => {
+                                        depth -= 1;
+                                        if depth == 0 {
+                                            j += 1;
+                                            break;
+                                        }
+                                    }
+                                    _ => {}
+                                }
+                                j += 1;
+                            }
+                            i = j;
+                        } else {
+                            i = next;
+                        }
+                    } else {
+                        classes += 1;
+                        i = next;
+                    }
+                }
+                b'[' => {
+                    let Some(end) = text[i..].find(']') else { i = bytes.len(); break };
+                    classes += 1;
+                    i += end + 1;
+                }
+                b'*' => {
+                    compound.any = true;
+                    i += 1;
+                }
+                _ => {
+                    let (name, next) = read_name(text, i);
+                    if name.is_empty() {
+                        i += 1;
+                        continue;
+                    }
+                    compound.tag = Some(name);
+                    tags += 1;
+                    i = next;
+                }
+            }
+        }
+        if compound != Compound::default() || !parts.is_empty() {
+            parts.push(Part { combinator, compound });
+        }
+        if parts.len() == 1 {
+            parts[0].combinator = Combinator::Descendant;
+        }
+    }
+    if parts.is_empty() {
+        return None;
+    }
+    Some(Selector { parts, specificity: ids * 1_000_000 + classes * 1_000 + tags })
+}
+
+fn read_name(text: &str, at: usize) -> (String, usize) {
+    let bytes = text.as_bytes();
+    let mut i = at;
+    let mut name = String::new();
+    while i < bytes.len() {
+        let b = bytes[i];
+        if b.is_ascii_alphanumeric() || b == b'-' || b == b'_' {
+            name.push((b as char).to_ascii_lowercase());
+            i += 1;
+        } else {
+            break;
+        }
+    }
+    (name, i)
+}
+
+/// The declarations that apply to `node`, in the order the cascade has
+/// them (least specific first, pages' own `style` last), the browser's
+/// own defaults already in `style`.
+pub fn cascade(doc: &Document, node: usize, sheet: &Sheet, style: &mut Style, parent_font: f32) {
+    let mut matched: Vec<(u32, usize, &(String, String))> = Vec::new();
+    for (order, rule) in sheet.rules.iter().enumerate() {
+        let best = rule.selectors.iter().filter(|s| s.matches(doc, node)).map(|s| s.specificity).max();
+        if let Some(spec) = best {
+            for decl in &rule.decls {
+                matched.push((spec, order, decl));
+            }
+        }
+    }
+    matched.sort_by(|a, b| (a.0, a.1).cmp(&(b.0, b.1)));
+    let mut decls: Vec<(String, String)> = matched.iter().map(|(_, _, d)| (*d).clone()).collect();
+    if let Some(inline) = doc.attr(node, "style") {
+        decls.extend(parse_decls(inline));
+    }
+    for (prop, value) in &decls {
+        if prop == "font-size" {
+            style.font_px = font_size(value, parent_font, style.font_px);
+        }
+    }
+    for (prop, value) in &decls {
+        apply(doc, node, prop, value, style);
+    }
+}
+
+fn apply(doc: &Document, node: usize, prop: &str, value: &str, style: &mut Style) {
+    let px = style.font_px;
+    match prop {
+        "display" => {
+            style.display = match value {
+                "none" => Display::None,
+                "block" | "flex" | "grid" | "table" | "list-item" | "flow-root" => Display::Block,
+                "inline" | "inline-block" | "inline-flex" | "inline-table" | "contents" => Display::Inline,
+                _ => style.display,
+            };
+        }
+        "color" => {
+            if let Some(color) = parse_color(value) {
+                style.color = color;
+            }
+        }
+        "background-color" => {
+            if let Some(color) = parse_color(value) {
+                style.bg = Some(color);
+            }
+        }
+        "background" => {
+            if let Some(color) = parse_color(value) {
+                style.bg = Some(color);
+            }
+        }
+        "font-size" => {}
+        "font-weight" => {
+            style.weight = match value.trim() {
+                "normal" | "lighter" => 400,
+                "bold" | "bolder" => 700,
+                other => other.parse::<u16>().map(|w| w.clamp(100, 900)).unwrap_or(style.weight),
+            };
+        }
+        "text-decoration" | "text-decoration-line" => {
+            style.underline = value.contains("underline");
+        }
+        "text-align" => {
+            style.align = match value {
+                "center" => Align::Center,
+                "right" => Align::Right,
+                _ => Align::Left,
+            };
+        }
+        "line-height" => {
+            let v = value.trim();
+            if let Some(n) = v.strip_suffix("px").and_then(|n| n.trim().parse::<f32>().ok()) {
+                if px > 0.0 {
+                    style.line_height = (n / px).clamp(0.8, 4.0);
+                }
+            } else if let Some(n) = v.strip_suffix('%').and_then(|n| n.trim().parse::<f32>().ok()) {
+                style.line_height = (n / 100.0).clamp(0.8, 4.0);
+            } else if let Some(n) = v.strip_suffix("em").and_then(|n| n.trim().parse::<f32>().ok()) {
+                style.line_height = n.clamp(0.8, 4.0);
+            } else if let Ok(n) = v.parse::<f32>() {
+                style.line_height = n.clamp(0.8, 4.0);
+            }
+        }
+        "white-space" => {
+            style.pre = value.starts_with("pre");
+        }
+        "margin" => {
+            let parts = lengths(value, px);
+            if parts.len() == 4 {
+                style.margin = [parts[0], parts[1], parts[2], parts[3]];
+            }
+        }
+        "margin-top" | "margin-right" | "margin-bottom" | "margin-left" => {
+            let Some(v) = length(value, px) else { return };
+            let i = match prop {
+                "margin-top" => 0,
+                "margin-right" => 1,
+                "margin-bottom" => 2,
+                _ => 3,
+            };
+            style.margin[i] = v;
+        }
+        "padding" => {
+            let parts = lengths(value, px);
+            if parts.len() == 4 {
+                style.padding = [parts[0], parts[1], parts[2], parts[3]];
+            }
+        }
+        "padding-top" | "padding-right" | "padding-bottom" | "padding-left" => {
+            let Some(v) = length(value, px) else { return };
+            let i = match prop {
+                "padding-top" => 0,
+                "padding-right" => 1,
+                "padding-bottom" => 2,
+                _ => 3,
+            };
+            style.padding[i] = v;
+        }
+        "width" | "max-width" => {
+            if let Some(v) = length(value, px) {
+                style.width = Some(style.width.map_or(v, |w| w.min(v)));
+            }
+        }
+        "list-style-type" | "list-style" => {
+            style.list = if value.contains("none") {
+                List::None
+            } else if value.contains("decimal") || value.contains("number") {
+                List::Decimal
+            } else if value.contains("disc") || value.contains("circle") || value.contains("square") || value.contains("list") {
+                List::Disc
+            } else {
+                style.list
+            };
+        }
+        "border-bottom" | "border-bottom-width" | "border-bottom-color" | "border-bottom-style" => {
+            if let Some(color) = parse_color(value) {
+                style.border_bottom = Some(color);
+            } else if prop == "border-bottom" && !value.contains("none") && !value.contains("0px") {
+                style.border_bottom = Some(style.color.with_alpha(64));
+            }
+        }
+        "border" => {
+            if let Some(color) = parse_color(value) {
+                style.border_bottom = Some(color);
+            }
+        }
+        "visibility" => {
+            if value == "hidden" {
+                style.display = Display::None;
+            }
+        }
+        _ => {
+            let _ = doc;
+        }
+    }
+    let _ = node;
+}
+
+fn lengths(value: &str, em: f32) -> Vec<f32> {
+    let values: Vec<f32> = value.split_ascii_whitespace().filter_map(|v| length(v, em)).collect();
+    match values.len() {
+        1 => vec![values[0]; 4],
+        2 => vec![values[0], values[1], values[0], values[1]],
+        3 => vec![values[0], values[1], values[2], values[1]],
+        _ => values.into_iter().take(4).collect(),
+    }
+}
+
+/// A CSS length in pixels: `px`, `em`, `rem`, `pt`, `%` of nothing (taken
+/// as 0) and a bare number as itself.
+pub fn length(value: &str, em: f32) -> Option<f32> {
+    let v = value.trim().to_ascii_lowercase();
+    if v == "auto" || v.is_empty() {
+        return None;
+    }
+    if let Some(n) = v.strip_suffix("px") {
+        return n.trim().parse::<f32>().ok();
+    }
+    if let Some(n) = v.strip_suffix("rem") {
+        return n.trim().parse::<f32>().ok().map(|n| n * 16.0);
+    }
+    if let Some(n) = v.strip_suffix("em") {
+        return n.trim().parse::<f32>().ok().map(|n| n * em);
+    }
+    if let Some(n) = v.strip_suffix("pt") {
+        return n.trim().parse::<f32>().ok().map(|n| n * 4.0 / 3.0);
+    }
+    if let Some(n) = v.strip_suffix('%') {
+        return n.trim().parse::<f32>().ok().map(|_| 0.0);
+    }
+    if let Some(n) = v.strip_suffix("vw") {
+        return n.trim().parse::<f32>().ok().map(|_| 0.0);
+    }
+    v.parse::<f32>().ok()
+}
+
+fn font_size(value: &str, parent: f32, current: f32) -> f32 {
+    let v = value.trim().to_ascii_lowercase();
+    let scale = match v.as_str() {
+        "xx-small" => Some(0.58),
+        "x-small" => Some(0.69),
+        "small" => Some(0.83),
+        "medium" => Some(1.0),
+        "large" => Some(1.2),
+        "x-large" => Some(1.44),
+        "xx-large" => Some(1.73),
+        "smaller" => Some(0.83),
+        "larger" => Some(1.2),
+        _ => None,
+    };
+    if let Some(scale) = scale {
+        return (parent * scale).clamp(6.0, 120.0);
+    }
+    if let Some(n) = v.strip_suffix('%') {
+        return n.trim().parse::<f32>().map(|n| (parent * n / 100.0).clamp(6.0, 120.0)).unwrap_or(current);
+    }
+    if let Some(n) = v.strip_suffix("rem") {
+        return n.trim().parse::<f32>().map(|n| (n * 16.0).clamp(6.0, 120.0)).unwrap_or(current);
+    }
+    if let Some(n) = v.strip_suffix("px") {
+        return n.trim().parse::<f32>().map(|n| n.clamp(6.0, 120.0)).unwrap_or(current);
+    }
+    if let Some(n) = v.strip_suffix("pt") {
+        return n.trim().parse::<f32>().map(|n| (n * 4.0 / 3.0).clamp(6.0, 120.0)).unwrap_or(current);
+    }
+    if let Some(n) = v.strip_suffix("em") {
+        return n.trim().parse::<f32>().map(|n| (parent * n).clamp(6.0, 120.0)).unwrap_or(current);
+    }
+    if let Some(n) = v.strip_suffix("vw") {
+        return n.trim().parse::<f32>().map(|n| (n * 8.2).clamp(6.0, 120.0)).unwrap_or(current);
+    }
+    current
+}
+
+/// A CSS colour: `#rgb`, `#rrggbb`, `#rrggbbaa`, `rgb()`, `rgba()`, a few
+/// names, and `transparent`.
+pub fn parse_color(value: &str) -> Option<Rgba> {
+    let v = value.trim().to_ascii_lowercase();
+    if v.starts_with("url(") || v.starts_with("linear-gradient") || v.starts_with("rgba(0, 0, 0, 0)") || v.starts_with("var(") {
+        return None;
+    }
+    if let Some(hex) = v.strip_prefix('#') {
+        let parse = |s: &str| u8::from_str_radix(s, 16).ok();
+        return match hex.len() {
+            3 => {
+                let r = parse(&hex[0..1])?;
+                let g = parse(&hex[1..2])?;
+                let b = parse(&hex[2..3])?;
+                Some(Rgba::rgb(r * 17, g * 17, b * 17))
+            }
+            4 => {
+                let r = parse(&hex[0..1])?;
+                let g = parse(&hex[1..2])?;
+                let b = parse(&hex[2..3])?;
+                let a = parse(&hex[3..4])?;
+                Some(Rgba { r: r * 17, g: g * 17, b: b * 17, a: a * 17 })
+            }
+            6 => Some(Rgba::rgb(parse(&hex[0..2])?, parse(&hex[2..4])?, parse(&hex[4..6])?)),
+            8 => Some(Rgba {
+                r: parse(&hex[0..2])?,
+                g: parse(&hex[2..4])?,
+                b: parse(&hex[4..6])?,
+                a: parse(&hex[6..8])?,
+            }),
+            _ => None,
+        };
+    }
+    if v.starts_with("rgb") {
+        let open = v.find('(')?;
+        let close = v.rfind(')')?;
+        let inner = &v[open + 1..close];
+        let parts: Vec<&str> = if inner.contains(',') {
+            inner.split(',').map(str::trim).collect()
+        } else {
+            inner.split(['/', ' ']).filter(|s| !s.trim().is_empty()).map(str::trim).collect()
+        };
+        let channel = |s: &str| -> Option<u8> {
+            if let Some(p) = s.strip_suffix('%') {
+                return p.trim().parse::<f32>().ok().map(|n| (n * 2.55).round().clamp(0.0, 255.0) as u8);
+            }
+            s.parse::<f32>().ok().map(|n| n.round().clamp(0.0, 255.0) as u8)
+        };
+        let alpha = parts.get(3).and_then(|s| {
+            if let Some(p) = s.strip_suffix('%') {
+                p.trim().parse::<f32>().ok().map(|n| (n * 2.55).round().clamp(0.0, 255.0) as u8)
+            } else {
+                s.parse::<f32>().ok().map(|n| (n * 255.0).round().clamp(0.0, 255.0) as u8)
+            }
+        });
+        return Some(Rgba {
+            r: channel(parts.first()?)?,
+            g: channel(parts.get(1)?)?,
+            b: channel(parts.get(2)?)?,
+            a: alpha.unwrap_or(255),
+        });
+    }
+    let named = match v.as_str() {
+        "black" => Rgba::rgb(0, 0, 0),
+        "white" => Rgba::rgb(255, 255, 255),
+        "red" => Rgba::rgb(255, 0, 0),
+        "green" => Rgba::rgb(0, 128, 0),
+        "blue" => Rgba::rgb(0, 0, 255),
+        "yellow" => Rgba::rgb(255, 255, 0),
+        "orange" => Rgba::rgb(255, 165, 0),
+        "purple" => Rgba::rgb(128, 0, 128),
+        "gray" | "grey" => Rgba::rgb(128, 128, 128),
+        "silver" => Rgba::rgb(192, 192, 192),
+        "lightgray" | "lightgrey" => Rgba::rgb(211, 211, 211),
+        "darkgray" | "darkgrey" => Rgba::rgb(169, 169, 169),
+        "maroon" => Rgba::rgb(128, 0, 0),
+        "olive" => Rgba::rgb(128, 128, 0),
+        "lime" => Rgba::rgb(0, 255, 0),
+        "aqua" | "cyan" => Rgba::rgb(0, 255, 255),
+        "teal" => Rgba::rgb(0, 128, 128),
+        "navy" => Rgba::rgb(0, 0, 128),
+        "fuchsia" | "magenta" => Rgba::rgb(255, 0, 255),
+        "transparent" => Rgba { r: 0, g: 0, b: 0, a: 0 },
+        _ => return None,
+    };
+    Some(named)
+}
