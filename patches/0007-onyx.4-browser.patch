+        assert_eq!(parts, vec![2.0, 4.0, 6.0, 4.0]);
+    }
+
+    #[test]
+    fn colours_are_read_in_the_ways_pages_write_them() {
+        assert_eq!(parse_color("#abc"), Some(Rgba::rgb(0xaa, 0xbb, 0xcc)));
+        assert_eq!(parse_color("rgba(0, 0, 0, 0.5)"), Some(Rgba { r: 0, g: 0, b: 0, a: 128 }));
+        assert_eq!(parse_color("red"), Some(Rgba::rgb(255, 0, 0)));
+    }
+}
