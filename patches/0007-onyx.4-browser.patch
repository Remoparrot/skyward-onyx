+/// Whether an element of this tag is drawn as a block of its own: a list
+/// of one is a list of boxes rather than a line.
+fn is_block_tag(tag: &str) -> bool {
+    matches!(
+        tag,
+        "div"
+            | "p"
+            | "ul"
+            | "ol"
+            | "dl"
+            | "table"
+            | "section"
+            | "article"
+            | "header"
+            | "footer"
+            | "nav"
+            | "main"
+            | "aside"
+            | "figure"
+            | "form"
+            | "blockquote"
+            | "pre"
+            | "h1"
+            | "h2"
+            | "h3"
+            | "h4"
+            | "h5"
+            | "h6"
+            | "details"
+            | "li"
+    )
+}
