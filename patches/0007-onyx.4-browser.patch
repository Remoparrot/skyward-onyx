@@ -0,0 +1,479 @@
+//! Reading a page's HTML into the tree the browser lays out.
+//!
+//! Not an HTML5 parser: a page is read the way people write it, with the
+//! tags left open closed where the next one makes it plain, and a tag it
+//! does not know kept as a box like any other.
+
+/// A node of the tree: an element, or a run of text. Text nodes have an
+/// empty `tag` and hold their text; elements hold their children.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Node {
+    /// The element's name in lowercase, empty in a text node.
+    pub tag: String,
+    /// The text a text node holds.
+    pub text: String,
+    pub attrs: Vec<(String, String)>,
+    pub children: Vec<usize>,
+    pub parent: usize,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Document {
+    pub nodes: Vec<Node>,
+    /// The synthetic node everything hangs from.
+    pub root: usize,
+}
+
+/// Elements that hold nothing and are never left open.
+const VOID: &[&str] = &[
+    "area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr",
+];
+
+/// Elements whose content is text up to their own end tag.
+const RAW: &[&str] = &["script", "style", "title", "textarea", "xmp", "noembed", "noframes"];
+
+impl Document {
+    pub fn attr(&self, node: usize, name: &str) -> Option<&str> {
+        self.nodes.get(node)?.attrs.iter().find(|(key, _)| key == name).map(|(_, value)| value.as_str())
+    }
+
+    pub fn has_attr(&self, node: usize, name: &str) -> bool {
+        self.attr(node, name).is_some()
+    }
+
+    pub fn is(&self, node: usize, tag: &str) -> bool {
+        self.nodes.get(node).is_some_and(|n| n.tag == tag)
+    }
+
+    /// Every element of `tag` below `node`, in reading order.
+    pub fn elements(&self, tag: &str) -> Vec<usize> {
+        let mut out = Vec::new();
+        let mut todo = vec![self.root];
+        while let Some(node) = todo.pop() {
+            if self.is(node, tag) {
+                out.push(node);
+            }
+            todo.extend(self.nodes[node].children.iter().rev().copied());
+        }
+        out
+    }
+
+    /// Add an element under `parent`, holding `text` where it is not
+    /// empty, and return the element's place.
+    pub fn add(&mut self, parent: usize, tag: &str, text: &str, attrs: Vec<(String, String)>) -> usize {
+        let node = self.nodes.len();
+        self.nodes.push(Node { tag: tag.into(), attrs, parent, ..Node::default() });
+        self.nodes[parent].children.push(node);
+        if !text.is_empty() {
+            let held = self.nodes.len();
+            self.nodes.push(Node { text: text.into(), parent: node, ..Node::default() });
+            self.nodes[node].children.push(held);
+        }
+        node
+    }
+
+    /// Take everything under `parent` away.
+    pub fn clear(&mut self, parent: usize) {
+        self.nodes[parent].children.clear();
+    }
+
+    /// The text a node holds, its children's text after it.
+    pub fn text_of(&self, node: usize) -> String {
+        let mut out = String::new();
+        let mut todo = vec![node];
+        while let Some(n) = todo.pop() {
+            let entry = &self.nodes[n];
+            if entry.tag.is_empty() {
+                out.push_str(&entry.text);
+            }
+            todo.extend(entry.children.iter().rev().copied());
+        }
+        out
+    }
+}
+
+/// Read `html` into a document.
+pub fn parse(html: &str) -> Document {
+    let mut p = Parser { nodes: Vec::new(), stack: Vec::new() };
+    p.nodes.push(Node { tag: "#document".into(), parent: 0, ..Node::default() });
+    p.stack.push(0);
+    let mut i = 0;
+    let bytes = html.as_bytes();
+    while i < bytes.len() {
+        if bytes[i] == b'<' {
+            let rest = &html[i..];
+            if rest.starts_with("<!--") {
+                i = find(&html, i + 4, "-->").map_or(html.len(), |at| at + 3);
+                continue;
+            }
+            if rest.starts_with("<!") || rest.starts_with("<?") {
+                i = html[i..].find('>').map_or(html.len(), |at| i + at + 1);
+                continue;
+            }
+            if rest.starts_with("</") {
+                let Some(end) = html[i..].find('>') else { break };
+                let name = tag_name(&html[i + 2..i + end]);
+                p.close(&name);
+                i += end + 1;
+                continue;
+            }
+            if rest.len() > 1 && is_name_start(bytes.get(i + 1).copied().unwrap_or(0)) {
+                let (name, attrs, after) = read_start_tag(html, i + 1);
+                p.open(&name, attrs);
+                i = after;
+                if RAW.contains(&name.as_str()) {
+                    // What a raw element holds is text up to its own end
+                    // tag, tags in it and all.
+                    let close = format!("</{name}");
+                    let at = find_ci(html, i, &close);
+                    let (body, next) = match at {
+                        Some(at) => (&html[i..at], at),
+                        None => (&html[i..], html.len()),
+                    };
+                    if !body.is_empty() {
+                        p.text(body);
+                    }
+                    i = next;
+                }
+                continue;
+            }
+            // A '<' not starting a tag is text.
+            p.text("<");
+            i += 1;
+        } else {
+            let at = html[i..].find('<').map_or(html.len(), |at| i + at);
+            p.text(&html[i..at]);
+            i = at;
+        }
+    }
+    let mut doc = Document { root: 0, nodes: p.nodes };
+    // Text has no attributes, and the root has no parent above it.
+    doc.nodes[0].parent = 0;
+    doc
+}
+
+fn is_name_start(b: u8) -> bool {
+    b.is_ascii_alphabetic()
+}
+
+fn tag_name(raw: &str) -> String {
+    raw.trim().chars().take_while(|c| !c.is_whitespace() && *c != '/' && *c != '>').flat_map(|c| c.to_lowercase()).collect()
+}
+
+/// Read a start tag's name and attributes from `at`, the character after
+/// its `<`; returns the name, its attributes, and where to go on.
+fn read_start_tag(html: &str, at: usize) -> (String, Vec<(String, String)>, usize) {
+    let bytes = html.as_bytes();
+    let mut i = at;
+    let mut name = String::new();
+    while i < bytes.len() {
+        let b = bytes[i];
+        if b == b'/' || b == b'>' || b.is_ascii_whitespace() {
+            break;
+        }
+        name.push((b as char).to_ascii_lowercase());
+        i += 1;
+    }
+    let mut attrs: Vec<(String, String)> = Vec::new();
+    loop {
+        while i < bytes.len() && (bytes[i].is_ascii_whitespace() || bytes[i] == b'/') {
+            i += 1;
+        }
+        if i >= bytes.len() || bytes[i] == b'>' {
+            i = (i + 1).min(html.len());
+            break;
+        }
+        // An attribute: its name up to `=`, whitespace or the tag's end.
+        let mut key = String::new();
+        while i < bytes.len() {
+            let b = bytes[i];
+            if b == b'=' || b == b'>' || b == b'/' || b.is_ascii_whitespace() {
+                break;
+            }
+            key.push((b as char).to_ascii_lowercase());
+            i += 1;
+        }
+        while i < bytes.len() && bytes[i].is_ascii_whitespace() {
+            i += 1;
+        }
+        let mut value = String::new();
+        if i < bytes.len() && bytes[i] == b'=' {
+            i += 1;
+            while i < bytes.len() && bytes[i].is_ascii_whitespace() {
+                i += 1;
+            }
+            if i < bytes.len() && (bytes[i] == b'"' || bytes[i] == b'\'') {
+                let quote = bytes[i];
+                i += 1;
+                let start = i;
+                while i < bytes.len() && bytes[i] != quote {
+                    i += 1;
+                }
+                value = decode_entities(&html[start..i.min(html.len())]);
+                if i < bytes.len() {
+                    i += 1;
+                }
+            } else {
+                let start = i;
+                while i < bytes.len() && !bytes[i].is_ascii_whitespace() && bytes[i] != b'>' {
+                    i += 1;
+                }
+                value = decode_entities(&html[start..i]);
+            }
+        }
+        if !key.is_empty() && !attrs.iter().any(|(k, _)| *k == key) {
+            attrs.push((key, value));
+        }
+    }
+    (name, attrs, i)
+}
+
+fn find(html: &str, from: usize, needle: &str) -> Option<usize> {
+    html.get(from..)?.find(needle).map(|at| from + at)
+}
+
+fn find_ci(html: &str, from: usize, needle: &str) -> Option<usize> {
+    let hay = html.get(from..)?.to_ascii_lowercase();
+    hay.find(needle).map(|at| from + at)
+}
+
+struct Parser {
+    nodes: Vec<Node>,
+    stack: Vec<usize>,
+}
+
+impl Parser {
+    fn top(&self) -> usize {
+        *self.stack.last().expect("the root is always open")
+    }
+
+    fn text(&mut self, text: &str) {
+        if text.is_empty() {
+            return;
+        }
+        let text = decode_entities(text);
+        let parent = self.top();
+        if let Some(&last) = self.nodes[parent].children.last() {
+            if self.nodes[last].tag.is_empty() {
+                self.nodes[last].text.push_str(&text);
+                return;
+            }
+        }
+        let node = self.nodes.len();
+        self.nodes.push(Node { text, parent, ..Node::default() });
+        self.nodes[parent].children.push(node);
+    }
+
+    fn open(&mut self, name: &str, attrs: Vec<(String, String)>) {
+        self.close_implied(name);
+        let parent = self.top();
+        let node = self.nodes.len();
+        self.nodes.push(Node { tag: name.to_string(), attrs, parent, ..Node::default() });
+        self.nodes[parent].children.push(node);
+        if !VOID.contains(&name) {
+            self.stack.push(node);
+        }
+    }
+
+    fn close(&mut self, name: &str) {
+        if name.is_empty() {
+            return;
+        }
+        if name == "br" {
+            self.open("br", Vec::new());
+            return;
+        }
+        let found = self.stack.iter().rposition(|&n| self.nodes[n].tag == name);
+        if let Some(at) = found {
+            self.stack.truncate(at);
+        }
+    }
+
+    /// Open elements a new one makes plain are closed before it opens.
+    fn close_implied(&mut self, name: &str) {
+        match name {
+            "p" | "div" | "ul" | "ol" | "table" | "form" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "section" | "article" | "header" | "footer" | "li" => {
+                self.pop_through(&["p"]);
+            }
+            _ => {}
+        }
+        match name {
+            "li" => self.pop_through(&["li"]),
+            "dt" | "dd" => self.pop_through(&["dt", "dd"]),
+            "tr" | "td" | "th" | "tbody" | "thead" | "tfoot" => {
+                self.pop_through(&["td", "th"]);
+                if name == "tr" {
+                    self.pop_through(&["tr"]);
+                }
+            }
+            "option" => self.pop_through(&["option"]),
+            "a" => self.pop_through(&["a"]),
+            "h1" | "h2" | "h3" | "h4" | "h5" | "h6" => self.pop_through(&["h1", "h2", "h3", "h4", "h5", "h6"]),
+            _ => {}
+        }
+    }
+
+    /// Close the nearest of `names` open, if one is, and everything after it.
+    fn pop_through(&mut self, names: &[&str]) {
+        let found = self.stack.iter().rposition(|&n| names.contains(&self.nodes[n].tag.as_str()));
+        if let Some(at) = found {
+            if at > 0 {
+                self.stack.truncate(at);
+            }
+        }
+    }
+}
+
+/// `&amp;` and the rest of what pages write: the common named ones, and
+/// every numeric one.
+pub fn decode_entities(text: &str) -> String {
+    if !text.contains('&') {
+        return text.to_string();
+    }
+    let mut out = String::with_capacity(text.len());
+    let bytes = text.as_bytes();
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] != b'&' {
+            let ch = text[i..].chars().next().expect("a character");
+            out.push(ch);
+            i += ch.len_utf8();
+            continue;
+        }
+        let Some(semi) = text[i..].find(';').filter(|at| *at <= 12) else {
+            out.push('&');
+            i += 1;
+            continue;
+        };
+        let body = &text[i + 1..i + semi];
+        let decoded = if let Some(num) = body.strip_prefix('#') {
+            let code = if let Some(hex) = num.strip_prefix(['x', 'X']) {
+                u32::from_str_radix(hex, 16).ok()
+            } else {
+                num.parse::<u32>().ok()
+            };
+            code.and_then(char::from_u32)
+        } else {
+            named(body)
+        };
+        match decoded {
+            Some(ch) => {
+                out.push(ch);
+                i += semi + 1;
+            }
+            None => {
+                out.push('&');
+                i += 1;
+            }
+        }
+    }
+    out
+}
+
+fn named(name: &str) -> Option<char> {
+    Some(match name {
+        "amp" => '&',
+        "lt" => '<',
+        "gt" => '>',
+        "quot" => '"',
+        "apos" => '\'',
+        "nbsp" => '\u{a0}',
+        "ensp" => '\u{2002}',
+        "emsp" => '\u{2003}',
+        "thinsp" => '\u{2009}',
+        "shy" => '\u{ad}',
+        "copy" => '\u{a9}',
+        "reg" => '\u{ae}',
+        "trade" => '\u{2122}',
+        "hellip" => '\u{2026}',
+        "mdash" => '\u{2014}',
+        "ndash" => '\u{2013}',
+        "lsquo" => '\u{2018}',
+        "rsquo" => '\u{2019}',
+        "ldquo" => '\u{201c}',
+        "rdquo" => '\u{201d}',
+        "laquo" => '\u{ab}',
+        "raquo" => '\u{bb}',
+        "middot" => '\u{b7}',
+        "bull" => '\u{2022}',
+        "times" => '\u{d7}',
+        "divide" => '\u{f7}',
+        "deg" => '\u{b0}',
+        "plusmn" => '\u{b1}',
+        "sect" => '\u{a7}',
+        "para" => '\u{b6}',
+        "dagger" => '\u{2020}',
+        "Dagger" => '\u{2021}',
+        "prime" => '\u{2032}',
+        "Prime" => '\u{2033}',
+        "euro" => '\u{20ac}',
+        "pound" => '\u{a3}',
+        "yen" => '\u{a5}',
+        "cent" => '\u{a2}',
+        "curren" => '\u{a4}',
+        "larr" => '\u{2190}',
+        "rarr" => '\u{2192}',
+        "uarr" => '\u{2191}',
+        "darr" => '\u{2193}',
+        "harr" => '\u{2194}',
+        "minus" => '\u{2212}',
+        "infin" => '\u{221e}',
+        "ne" => '\u{2260}',
+        "le" => '\u{2264}',
+        "ge" => '\u{2265}',
+        "frac12" => '\u{bd}',
+        "frac14" => '\u{bc}',
+        "frac34" => '\u{be}',
+        "sup2" => '\u{b2}',
+        "sup3" => '\u{b3}',
+        "micro" => '\u{b5}',
+        "star" => '\u{2606}',
+        "starf" => '\u{2605}',
+        "spades" => '\u{2660}',
+        "clubs" => '\u{2663}',
+        "hearts" => '\u{2665}',
+        "diams" => '\u{2666}',
+        _ => return None,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_page_is_read_with_the_tags_it_leaves_out_closed() {
+        let doc = parse("<ul><li>one<li>two</ul><p>a<p>b");
+        let lis = doc.elements("li");
+        assert_eq!(lis.len(), 2);
+        let ps = doc.elements("p");
+        assert_eq!(ps.len(), 2);
+        assert_eq!(doc.text_of(ps[1]), "b");
+    }
+
+    #[test]
+    fn a_script_holds_tags_and_all_as_text() {
+        let doc = parse("<div>a<script>if (1 < 2) { x = '<b>'; }</script>b</div>");
+        let div = doc.elements("div")[0];
+        assert_eq!(doc.text_of(div), "ab");
+        let script = doc.elements("script")[0];
+        assert!(doc.nodes[script].text.contains("<b>"));
+    }
+
+    #[test]
+    fn entities_are_read() {
+        assert_eq!(decode_entities("a &amp; b &lt;c&gt; &#65;&#x42; &nbsp;"), "a & b <c> AB \u{a0}");
+        assert_eq!(decode_entities("100% &notanentity;"), "100% &notanentity;");
+    }
+
+    #[test]
+    fn attributes_may_be_bare_or_quoted() {
+        let doc = parse("<li class=\"b_algo\" data-id iid=SERP.5329><a href=/x?a=1&amp;b=2>t</a></li>");
+        let li = doc.elements("li")[0];
+        assert_eq!(doc.attr(li, "class"), Some("b_algo"));
+        assert_eq!(doc.attr(li, "data-id"), Some(""));
+        assert_eq!(doc.attr(li, "iid"), Some("SERP.5329"));
+        let a = doc.elements("a")[0];
+        assert_eq!(doc.attr(a, "href"), Some("/x?a=1&b=2"));
+    }
+}
diff --git a/crates/skyward-ui/src/web/image.rs b/crates/skyward-ui/src/web/image.rs
new file mode 100644
index 0000000..ea94210
--- /dev/null
+++ b/crates/skyward-ui/src/web/image.rs
@@ -0,0 +1,117 @@
+//! Pictures a page shows: decoding them, and drawing them at the size the
+//! page's layout gives them.
+
+use crate::canvas::Canvas;
+use crate::color::Rgba;
+
+/// A decoded picture, RGBA straight alpha, rows top to bottom.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Picture {
+    pub w: u32,
+    pub h: u32,
+    pub rgba: Vec<u8>,
+}
+
+/// The longest side a picture is kept at, so a page of camera photos does
+/// not fill the recovery's memory.
+pub const MAX_SIDE: u32 = 1024;
+
+/// Decode a picture of any of the formats pages use, no larger than
+/// [`MAX_SIDE`] a side: `None` for what cannot be read.
+pub fn decode(bytes: &[u8]) -> Option<Picture> {
+    if bytes.len() < 16 || bytes.len() > 24 << 20 {
+        return None;
+    }
+    let image = image::load_from_memory(bytes).ok()?;
+    let image = if image.width().max(image.height()) > MAX_SIDE {
+        image.thumbnail(MAX_SIDE, MAX_SIDE)
+    } else {
+        image
+    };
+    let rgba = image.to_rgba8();
+    let (w, h) = rgba.dimensions();
+    if w == 0 || h == 0 {
+        return None;
+    }
+    Some(Picture { w, h, rgba: rgba.into_raw() })
+}
+
+/// What a page's images are kept as while it is read: each URL holds one
+/// picture, and the layout names them by place.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Store {
+    pub urls: Vec<String>,
+    pub pics: Vec<Option<Picture>>,
+}
+
+impl Store {
+    pub fn get(&self, url: &str) -> Option<usize> {
+        self.urls.iter().position(|u| u == url).filter(|at| self.pics[*at].is_some())
+    }
+
+    pub fn push(&mut self, url: String, pic: Option<Picture>) -> usize {
+        if let Some(at) = self.urls.iter().position(|u| *u == url) {
+            if self.pics[at].is_none() {
+                self.pics[at] = pic;
+            }
+            return at;
+        }
+        self.urls.push(url);
+        self.pics.push(pic);
+        self.urls.len() - 1
+    }
+}
+
+/// Draw `pic` in the rectangle at (`x`, `y`) of `w` × `h`, linear-sampled
+/// and laid over what is under it; pixels outside the canvas or outside
+/// the rows it holds are dropped.
+pub fn draw(c: &mut Canvas, pic: &Picture, x: f32, y: f32, w: f32, h: f32) {
+    if w < 1.0 || h < 1.0 {
+        return;
+    }
+    let held = c.held();
+    let (x0, x1) = (x.floor() as i32, (x + w).ceil() as i32);
+    let (y0, y1) = (y.floor() as i32, (y + h).ceil() as i32);
+    let (top, bottom) = (y0.max(held.start as i32), y1.min(held.end as i32));
+    let (left, right) = (x0.max(0), x1.min(c.w as i32));
+    if left >= right || top >= bottom {
+        return;
+    }
+    let sx = pic.w as f32 / w;
+    let sy = pic.h as f32 / h;
+    let (iw, ih) = (pic.w as usize, pic.h as usize);
+    for py in top..bottom {
+        let v = ((py as f32 + 0.5 - y) * sy - 0.5).max(0.0);
+        let v0 = v.floor() as usize;
+        let v1 = (v0 + 1).min(ih.saturating_sub(1));
+        let fv = v - v0 as f32;
+        let row0 = v0.min(ih.saturating_sub(1)) * iw;
+        let row1 = v1 * iw;
+        for px in left..right {
+            let u = ((px as f32 + 0.5 - x) * sx - 0.5).max(0.0);
+            let u0 = u.floor() as usize;
+            let u1 = (u0 + 1).min(iw.saturating_sub(1));
+            let fu = u - u0 as f32;
+            let u0 = u0.min(iw.saturating_sub(1));
+            let at = |row: usize, col: usize| -> [u8; 4] {
+                let i = (row + col) * 4;
+                [pic.rgba[i], pic.rgba[i + 1], pic.rgba[i + 2], pic.rgba[i + 3]]
+            };
+            let a = at(row0, u0);
+            let b = at(row0, u1);
+            let cc = at(row1, u0);
+            let d = at(row1, u1);
+            let mix = |i: usize, fa: f32, fb: f32| -> u8 {
+                let top = a[i] as f32 + (b[i] as f32 - a[i] as f32) * fa;
+                let bottom = cc[i] as f32 + (d[i] as f32 - cc[i] as f32) * fa;
+                (top + (bottom - top) * fb).round().clamp(0.0, 255.0) as u8
+            };
+            let alpha = mix(3, fu, fv);
+            if alpha == 0 {
+                continue;
+            }
+            let color = Rgba { r: mix(0, fu, fv), g: mix(1, fu, fv), b: mix(2, fu, fv), a: alpha };
+            c.blend(px, py, color, 1.0);
+        }
+    }
+}
diff --git a/crates/skyward-ui/src/web/layout.rs b/crates/skyward-ui/src/web/layout.rs
new file mode 100644
index 0000000..20bcf78
--- /dev/null
+++ b/crates/skyward-ui/src/web/layout.rs
@@ -0,0 +1,639 @@
+//! Laying a page out: blocks stacked down the page, lines of text broken
+//! to fit, pictures placed where they are written.
+//!
+//! Everything here works in CSS pixels; the pieces laid out are turned
+//! into the panel's pixels as they are emitted, at `width / CSS_WIDTH`.
+
+use super::css::{self, Align, Display, List, Sheet, Style};
+use super::html::Document;
+use super::image::Store;
+use super::{Item, Link, Loaded, Page};
+use crate::color::Rgba;
+use crate::font::Fonts;
+use crate::geom::Rect;
+
+/// The width pages are laid out as, in CSS pixels.
+pub const CSS_WIDTH: f32 = 820.0;
+
+/// The colour text is when neither the page nor the browser says.
+const INK: Rgba = Rgba::rgb(0x20, 0x20, 0x20);
+
+/// How deep the tree is followed before the rest is left out.
+const MAX_DEPTH: usize = 200;
+
+pub fn lay_out(loaded: Loaded, fonts: &Fonts, width: f32) -> Page {
+    let scale = (width / CSS_WIDTH).max(0.2);
+    let sheet = stylesheet(&loaded.doc);
+    let pics = loaded.images.pics.clone();
+    let mut sizes = Vec::with_capacity(pics.len());
+    for pic in &pics {
+        sizes.push(pic.as_ref().map(|p| (p.w as f32, p.h as f32)));
+    }
+    let mut l = Layouter {
+        doc: &loaded.doc,
+        fonts,
+        scale,
+        sheet,
+        styles: Vec::new(),
+        items: Vec::new(),
+        links: Vec::new(),
+        measure: crate::canvas::Canvas::new(1, 1),
+        bold: fonts.face(620.0).ok(),
+        base: loaded.url.clone(),
+        pics: &loaded.images,
+        sizes,
+    };
+    l.styles = vec![Style::root(); l.doc.nodes.len()];
+    // A page names its base in <base>; links are worked out against it.
+    if let Some(&base) = l.doc.elements("base").first() {
+        if let Some(href) = l.doc.attr(base, "href") {
+            l.base = resolve(&l.base, href);
+        }
+    }
+    let root_style = l.compute(0, &Style::root());
+    let body = l.doc.nodes.iter().position(|n| n.tag == "body");
+    let bottom = match body {
+        Some(body) => {
+            let y = l.block(body, 0.0, 0.0, CSS_WIDTH);
+            y.max(CSS_WIDTH * 0.5)
+        }
+        None => l.flow(0, 0.0, 0.0, CSS_WIDTH).max(CSS_WIDTH * 0.5),
+    };
+    let bg = body
+        .and_then(|b| l.styles[b].bg)
+        .or(root_style.bg)
+        .unwrap_or(Rgba::rgb(255, 255, 255));
+    Page {
+        url: loaded.url.clone(),
+        title: loaded.title.clone(),
+        width,
+        height: (bottom * l.scale).ceil(),
+        bg,
+        items: l.items,
+        links: l.links,
+        images: std::sync::Arc::new(loaded.images),
+    }
+}
+
+fn stylesheet(doc: &Document) -> Sheet {
+    let mut sheet = Sheet::default();
+    for node in doc.elements("style") {
+        let css = doc.nodes[node].text.clone();
+        sheet.rules.extend(Sheet::parse(&css).rules);
+    }
+    sheet
+}
+
+#[derive(Clone, Debug, PartialEq)]
+struct Mark {
+    px: f32,
+    weight: u16,
+    color: Rgba,
+    href: Option<String>,
+    lh: f32,
+    mono: bool,
+}
+
+impl Mark {
+    fn of(style: &Style, href: Option<String>) -> Mark {
+        Mark { px: style.font_px, weight: style.weight, color: style.color, href, lh: style.line_height, mono: false }
+    }
+}
+
+enum Piece {
+    Text(String, Mark),
+    Space(Mark),
+    Image { pic: Option<usize>, w: f32, h: f32, href: Option<String> },
+    Break,
+}
+
+struct Layouter<'a> {
+    doc: &'a Document,
+    fonts: &'a Fonts,
+    scale: f32,
+    sheet: Sheet,
+    styles: Vec<Style>,
+    items: Vec<Item>,
+    links: Vec<Link>,
+    measure: crate::canvas::Canvas,
+    bold: Option<crate::font::Face>,
+    base: String,
+    pics: &'a Store,
+    sizes: Vec<Option<(f32, f32)>>,
+}
+
+impl<'a> Layouter<'a> {
+    fn dp(&self, css: f32) -> f32 {
+        css * self.scale
+    }
+
+    /// The width `text` takes at `px`, drawn in the face of `weight`.
+    fn text_w_at(&self, text: &str, px: f32, weight: u16) -> f32 {
+        let face = if weight >= 600 { self.bold.as_ref().unwrap_or(&self.fonts.body) } else { &self.fonts.body };
+        self.measure.text_width(face, text, self.dp(px)) / self.scale
+    }
+
+    fn space_at(&self, px: f32, weight: u16) -> f32 {
+        self.text_w_at(" ", px, weight)
+    }
+
+    fn ascent(&self, px: f32) -> f32 {
+        let (top, _) = self.fonts.body.line(self.dp(px));
+        -top / self.scale
+    }
+
+    /// Compute every element's style, from the root down.
+    fn compute(&mut self, node: usize, parent: &Style) -> Style {
+        let entry = &self.doc.nodes[node];
+        if entry.tag.is_empty() {
+            let mut style = parent.clone();
+            style.display = Display::Inline;
+            style.href = None;
+            self.styles[node] = style.clone();
+            return style;
+        }
+        let mut style = Style::root();
+        css::defaults(self.doc, node, parent, &mut style);
+        css::cascade(self.doc, node, &self.sheet, &mut style, parent.font_px);
+        if style.font_px < 1.0 {
+            style.font_px = 16.0;
+        }
+        // A link is made whole against the page's own address, and one that
+        // goes nowhere a browser can follow is no link at all.
+        if let Some(raw) = style.href.clone() {
+            let lower = raw.trim().to_ascii_lowercase();
+            style.href = if lower.starts_with("javascript:")
+                || lower.starts_with("mailto:")
+                || lower.starts_with("tel:")
+                || lower.starts_with("data:")
+            {
+                None
+            } else {
+                Some(resolve(&self.base, &raw))
+            };
+        }
+        // What a page's menu is: a row of links, not a stack of bullets.
+        if matches!(entry.tag.as_str(), "ul" | "ol" | "li" | "a") && self.inside_nav(node, 4) {
+            style.display = Display::Inline;
+            style.list = List::None;
+            style.margin = [0.0; 4];
+            style.padding = [0.0; 4];
+        }
+        self.styles[node] = style.clone();
+        let children = entry.children.clone();
+        for child in children {
+            self.compute(child, &style);
+        }
+        style
+    }
+
+    /// Whether one of the nearest `upto` elements above `node` is a menu.
+    fn inside_nav(&self, node: usize, upto: usize) -> bool {
+        let mut at = node;
+        for _ in 0..upto {
+            let parent = self.doc.nodes[at].parent;
+            if parent == at {
+                return false;
+            }
+            at = parent;
+            if self.doc.is(at, "nav") {
+                return true;
+            }
+        }
+        false
+    }
+
+    /// Lay `node` out as a block at (`x`, `y`), no wider than `width`;
+    /// returns the bottom of what it drew.
+    fn block(&mut self, node: usize, x: f32, y: f32, width: f32) -> f32 {
+        let s = self.styles[node].clone();
+        if s.display == Display::None {
+            return y;
+        }
+        let (margin, padding) = (s.margin, s.padding);
+        let cy = y + margin[0];
+        let bx = x + margin[3];
+        let mut inner_w = width - margin[1] - margin[3] - padding[1] - padding[3];
+        if inner_w < 1.0 {
+            inner_w = 1.0;
+        }
+        if let Some(w) = s.width {
+            inner_w = inner_w.min(w.max(1.0));
+        }
+        let inner_x = bx + padding[3];
+        let content_top = cy + padding[0];
+        let bg_at = if s.bg.is_some() {
+            self.items.push(Item::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0, color: INK });
+            Some(self.items.len() - 1)
+        } else {
+            None
+        };
+        if s.list != List::None && self.doc.is(node, "li") {
+            self.marker(node, &s, inner_x, content_top);
+        }
+        let bottom = self.flow(node, inner_x, content_top, inner_w);
+        let height = (bottom - content_top).max(0.0);
+        if let Some(at) = bg_at {
+            let color = s.bg.expect("the background was pushed");
+            self.items[at] = Item::Rect {
+                x: self.dp(inner_x - padding[3]),
+                y: self.dp(cy),
+                w: self.dp(inner_w + padding[1] + padding[3]),
+                h: self.dp(height + padding[0] + padding[2]),
+                color,
+            };
+        }
+        let mut bottom = content_top + height + padding[2];
+        if let Some(color) = s.border_bottom {
+            if height > 0.0 {
+                self.items.push(Item::Rule {
+                    x0: self.dp(inner_x),
+                    y0: self.dp(bottom + 0.5),
+                    x1: self.dp(inner_x + inner_w),
+                    y1: self.dp(bottom + 0.5),
+                    t: self.dp(1.0).max(1.0),
+                    color,
+                });
+            }
+        }
+        bottom += margin[2];
+        bottom
+    }
+
+    /// A list item's bullet or number, in the padding left of its text.
+    fn marker(&mut self, node: usize, s: &Style, inner_x: f32, top: f32) {
+        let text = match s.list {
+            List::Decimal => {
+                let parent = self.doc.nodes[node].parent;
+                let index = self.doc.nodes[parent]
+                    .children
+                    .iter()
+                    .take_while(|&&c| c != node)
+                    .filter(|&&c| self.doc.is(c, "li"))
+                    .count()
+                    + 1;
+                format!("{index}.")
+            }
+            _ => "\u{2022}".to_string(),
+        };
+        let px = s.font_px;
+        self.items.push(Item::Text {
+            x: self.dp(inner_x - px * 1.05),
+            baseline: self.dp(top + self.ascent(px)),
+            text,
+            px: self.dp(px),
+            weight: s.weight,
+            color: s.color,
+            mono: false,
+        });
+    }
+
+    /// Lay the contents of `node` out: blocks one after another, text and
+    /// pictures as lines between them.
+    fn flow(&mut self, node: usize, x: f32, y: f32, width: f32) -> f32 {
+        let children = self.doc.nodes[node].children.clone();
+        let mut pieces = Vec::new();
+        let mut cy = y;
+        for child in children {
+            let st = self.styles[child].clone();
+            if st.display == Display::None {
+                continue;
+            }
+            if st.display == Display::Block {
+                cy = self.flush(&mut pieces, x, cy, width);
+                cy = self.block(child, x, cy, width);
+            } else {
+                self.collect(child, &mut pieces, None, 0);
+                let _ = &st;
+            }
+        }
+        self.flush(&mut pieces, x, cy, width)
+    }
+
+    /// Turn a node drawn in a line into pieces.
+    fn collect(&mut self, node: usize, out: &mut Vec<Piece>, href: Option<String>, depth: usize) {
+        if depth > MAX_DEPTH {
+            return;
+        }
+        let entry = &self.doc.nodes[node];
+        if entry.tag.is_empty() {
+            let style = self.styles[node].clone();
+            let mark = Mark::of(&style, href);
+            if style.pre {
+                let mut first = true;
+                for line in entry.text.split('\n') {
+                    if !first {
+                        out.push(Piece::Break);
+                    }
+                    first = false;
+                    if !line.is_empty() {
+                        out.push(Piece::Text(line.replace(' ', "\u{a0}"), mark.clone()));
+                    }
+                }
+            } else {
+                push_words(&entry.text, &mark, out);
+            }
+            return;
+        }
+        if entry.tag == "br" {
+            out.push(Piece::Break);
+            return;
+        }
+        if entry.tag == "img" {
+            let style = self.styles[node].clone();
+            let href = style.href.clone().or(href);
+            let pic = entry
+                .attrs
+                .iter()
+                .find(|(k, _)| k == "src" || k == "data-src")
+                .map(|(_, src)| resolve(&self.base, src))
+                .and_then(|url| self.pics.get(&url));
+            let (mut w, mut h) = match pic.and_then(|at| self.sizes.get(at).copied().flatten()) {
+                Some((w, h)) => (w, h),
+                None => (120.0, 90.0),
+            };
+            if let Some(sw) = style.width {
+                if sw > 0.0 {
+                    let ratio = sw / w.max(1.0);
+                    w = sw;
+                    h *= ratio;
+                }
+            }
+            out.push(Piece::Image { pic, w, h, href });
+            return;
+        }
+        let style = self.styles[node].clone();
+        let href = style.href.clone().or(href);
+        let children = entry.children.clone();
+        for child in children {
+            let st = &self.styles[child];
+            if st.display == Display::None {
+                continue;
+            }
+            if st.display == Display::Block {
+                // A block met inside a line ends it and starts again after.
+                out.push(Piece::Break);
+                self.collect(child, out, href.clone(), depth + 1);
+                out.push(Piece::Break);
+                continue;
+            }
+            self.collect(child, out, href.clone(), depth + 1);
+        }
+        // What a page's menu holds is separated from the next by a space.
+        if entry.tag == "li" && self.inside_nav(node, 3) {
+            out.push(Piece::Space(Mark::of(&style, None)));
+        }
+    }
+
+    fn flush(&mut self, pieces: &mut Vec<Piece>, x: f32, y: f32, width: f32) -> f32 {
+        if pieces.is_empty() {
+            return y;
+        }
+        let mut y = y;
+        let mut runs: Vec<(f32, String, Mark)> = Vec::new();
+        let mut imgs: Vec<(f32, Option<usize>, f32, f32, Option<String>)> = Vec::new();
+        let mut cursor = 0.0f32;
+        let mut space: Option<Mark> = None;
+        for piece in pieces.drain(..) {
+            match piece {
+                Piece::Break => {
+                    y = self.end_line(y, x, cursor, width, Align::Left, &mut runs, &mut imgs);
+                    cursor = 0.0;
+                    space = None;
+                }
+                Piece::Space(mark) => {
+                    if cursor > 0.0 {
+                        space = Some(mark);
+                    }
+                }
+                Piece::Text(text, mark) => {
+                    if text.is_empty() {
+                        continue;
+                    }
+                    let w = self.text_w_at(&text, mark.px, mark.weight);
+                    if let Some(pending) = &space {
+                        if cursor > 0.0 {
+                            cursor += self.space_at(pending.px, pending.weight);
+                        }
+                        space = None;
+                    }
+                    if cursor > 0.0 && cursor + w > width {
+                        y = self.end_line(y, x, cursor, width, Align::Left, &mut runs, &mut imgs);
+                        cursor = 0.0;
+                    }
+                    if w > width && cursor == 0.0 {
+                        for chunk in self.break_word(&text, &mark, width) {
+                            let cw = self.text_w_at(&chunk, mark.px, mark.weight);
+                            if cursor > 0.0 && cursor + cw > width {
+                                y = self.end_line(y, x, cursor, width, Align::Left, &mut runs, &mut imgs);
+                                cursor = 0.0;
+                            }
+                            runs.push((cursor, chunk, mark.clone()));
+                            cursor += cw;
+                        }
+                        continue;
+                    }
+                    runs.push((cursor, text, mark));
+                    cursor += w;
+                }
+                Piece::Image { pic, w, h, href } => {
+                    if let Some(pending) = &space {
+                        if cursor > 0.0 {
+                            cursor += self.space_at(pending.px, pending.weight);
+                        }
+                        space = None;
+                    }
+                    let mut w = w;
+                    let mut h = h;
+                    if w > width {
+                        let ratio = width / w.max(1.0);
+                        w = width;
+                        h *= ratio;
+                    }
+                    if cursor > 0.0 && cursor + w > width {
+                        y = self.end_line(y, x, cursor, width, Align::Left, &mut runs, &mut imgs);
+                        cursor = 0.0;
+                    }
+                    imgs.push((cursor, pic, w, h, href));
+                    cursor += w;
+                }
+            }
+        }
+        if cursor > 0.0 || !runs.is_empty() || !imgs.is_empty() {
+            y = self.end_line(y, x, cursor, width, Align::Left, &mut runs, &mut imgs);
+        }
+        y
+    }
+
+    fn break_word(&self, text: &str, mark: &Mark, width: f32) -> Vec<String> {
+        let mut out = Vec::new();
+        let mut line = String::new();
+        for ch in text.chars() {
+            let mut trial = line.clone();
+            trial.push(ch);
+            if !line.is_empty() && self.text_w_at(&trial, mark.px, mark.weight) > width {
+                out.push(std::mem::take(&mut line));
+            }
+            line.push(ch);
+        }
+        if !line.is_empty() {
+            out.push(line);
+        }
+        out
+    }
+
+    fn end_line(
+        &mut self,
+        y: f32,
+        origin: f32,
+        cursor: f32,
+        width: f32,
+        align: Align,
+        runs: &mut Vec<(f32, String, Mark)>,
+        imgs: &mut Vec<(f32, Option<usize>, f32, f32, Option<String>)>,
+    ) -> f32 {
+        if runs.is_empty() && imgs.is_empty() {
+            return y;
+        }
+        let text_h = runs.iter().map(|(_, _, m)| m.px * m.lh).fold(0.0, f32::max);
+        let img_h = imgs.iter().map(|(_, _, _, h, _)| *h).fold(0.0, f32::max);
+        let line_h = text_h.max(img_h).max(1.0);
+        let ascent = runs.iter().map(|(_, _, m)| self.ascent(m.px)).fold(0.0, f32::max);
+        let shift = origin
+            + match align {
+            Align::Left => 0.0,
+            Align::Center => ((width - cursor) / 2.0).max(0.0),
+            Align::Right => (width - cursor).max(0.0),
+        };
+        let text_top = y + (line_h - text_h) / 2.0;
+        let baseline = text_top + ascent;
+        for (rx, text, mark) in runs.drain(..) {
+            let rx = shift + rx;
+            self.items.push(Item::Text {
+                x: self.dp(rx),
+                baseline: self.dp(baseline),
+                text: text.clone(),
+                px: self.dp(mark.px),
+                weight: mark.weight,
+                color: mark.color,
+                mono: mark.mono,
+            });
+            if let Some(href) = &mark.href {
+                let w = self.text_w_at(&text, mark.px, mark.weight).max(1.0);
+                self.links.push(Link {
+                    rect: Rect::new(self.dp(rx), self.dp(y), self.dp(w), self.dp(line_h.max(mark.px))),
+                    href: href.clone(),
+                });
+            }
+        }
+        for (rx, pic, w, h, href) in imgs.drain(..) {
+            let rx = shift + rx;
+            let iy = y + (line_h - h) / 2.0;
+            match pic {
+                Some(pic) => self.items.push(Item::Image { x: self.dp(rx), y: self.dp(iy), w: self.dp(w), h: self.dp(h), pic }),
+                None => self.items.push(Item::Rect {
+                    x: self.dp(rx),
+                    y: self.dp(iy),
+                    w: self.dp(w),
+                    h: self.dp(h),
+                    color: Rgba::rgb(0xe8, 0xe8, 0xe8),
+                }),
+            }
+            if let Some(href) = &href {
+                self.links.push(Link { rect: Rect::new(self.dp(rx), self.dp(iy), self.dp(w), self.dp(h)), href: href.clone() });
+            }
+        }
+        y + line_h
+    }
+}
+
+/// Split what a text node holds into words and the spaces between them,
+/// a line able to break between any two words and around each CJK
+/// character.
+fn push_words(text: &str, mark: &Mark, out: &mut Vec<Piece>) {
+    let mut word = String::new();
+    let flush = |word: &mut String, out: &mut Vec<Piece>| {
+        if !word.is_empty() {
+            out.push(Piece::Text(std::mem::take(word), mark.clone()));
+        }
+    };
+    for ch in text.chars() {
+        if ch.is_whitespace() {
+            flush(&mut word, out);
+            out.push(Piece::Space(mark.clone()));
+            continue;
+        }
+        if breaks_around(ch) {
+            flush(&mut word, out);
+            out.push(Piece::Text(ch.to_string(), mark.clone()));
+            continue;
+        }
+        word.push(ch);
+    }
+    flush(&mut word, out);
+}
+
+/// Whether a line may break around `ch` while drawing it: CJK text breaks
+/// between nearly any two characters.
+fn breaks_around(ch: char) -> bool {
+    let c = ch as u32;
+    (0x2e80..=0x9fff).contains(&c)
+        || (0xac00..=0xd7af).contains(&c)
+        || (0xf900..=0xfaff).contains(&c)
+        || (0xff00..=0xffef).contains(&c)
+        || (0x20000..=0x2ffff).contains(&c)
+        || (0x3000..=0x303f).contains(&c)
+}
+
+/// Work out where a link on `base` goes.
+pub fn resolve(base: &str, href: &str) -> String {
+    let href = href.trim();
+    if href.is_empty() {
+        return base.to_string();
+    }
+    let lower = href.to_ascii_lowercase();
+    if lower.starts_with("http://") || lower.starts_with("https://") {
+        return href.to_string();
+    }
+    if let Some(rest) = href.strip_prefix("//") {
+        let scheme = if base.starts_with("http://") { "http:" } else { "https:" };
+        return format!("{scheme}//{rest}");
+    }
+    let no_fragment = href.split('#').next().unwrap_or("");
+    let (scheme, rest) = split_scheme(base);
+    if lower.starts_with("javascript:") || lower.starts_with("data:") || lower.starts_with("mailto:") || lower.starts_with("tel:") || lower.starts_with("#") {
+        return base.split('#').next().unwrap_or(base).to_string();
+    }
+    let (authority, path) = match rest.find('/') {
+        Some(at) => (&rest[..at], &rest[at..]),
+        None => (rest, "/"),
+    };
+    if href.starts_with('/') {
+        return format!("{scheme}://{authority}{no_fragment}");
+    }
+    // A relative path: keep the base's last folder, or drop it for `..`.
+    let dir = match path.rfind('/') {
+        Some(at) => &path[..=at],
+        None => "/",
+    };
+    let mut segments: Vec<&str> = dir.split('/').filter(|s| !s.is_empty()).collect();
+    for part in no_fragment.split('/') {
+        match part {
+            ".." => {
+                segments.pop();
+            }
+            "." | "" => {}
+            other => segments.push(other),
+        }
+    }
+    let joined = segments.join("/");
+    let path = if joined.is_empty() { "/".to_string() } else { format!("/{joined}") };
+    format!("{scheme}://{authority}{path}")
+}
+
+fn split_scheme(url: &str) -> (&str, &str) {
+    match url.find("://") {
+        Some(at) => (&url[..at], &url[at + 3..]),
+        None => ("https", url),
+    }
+}
diff --git a/crates/skyward-ui/src/web/mod.rs b/crates/skyward-ui/src/web/mod.rs
new file mode 100644
index 0000000..e94dd08
--- /dev/null
+++ b/crates/skyward-ui/src/web/mod.rs
@@ -0,0 +1,520 @@
+//! Reading a web page and drawing it: a small browser for a recovery.
+//!
+//! A page is fetched, read into a tree, laid out as boxes and lines of
+//! text, and drawn a band at a time as it scrolls. Scripts are not run,
+//! which the pages that need them show plainly; everything else is drawn
+//! as written: headings, paragraphs, lists, tables, colours and pictures.
+
+pub mod css;
+pub mod html;
+pub mod image;
+mod layout;
+
+use crate::canvas::Canvas;
+use crate::color::Rgba;
+use crate::font::Fonts;
+use crate::geom::Rect;
+use std::io::Read;
+use std::sync::Arc;
+
+/// The width a page is laid out as, in CSS pixels: a phone's browser asks
+/// for a page this wide and shrinks it to the screen.
+pub use layout::CSS_WIDTH;
+
+/// What reading a URL gave: the page read, and the pictures it shows.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Loaded {
+    /// The URL after the server's redirects.
+    pub url: String,
+    pub title: String,
+    pub doc: html::Document,
+    pub images: image::Store,
+}
+
+/// Why a URL did not give a page.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Fail {
+    /// The URL serves a file rather than a page: what to save it as, and
+    /// what kind it is.
+    Download { url: String, name: String, kind: String },
+    /// The page could not be read, and why.
+    Why(String),
+}
+
+impl std::fmt::Display for Fail {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Fail::Download { name, .. } => write!(f, "{name} is a download, not a page"),
+            Fail::Why(why) => f.write_str(why),
+        }
+    }
+}
+
+/// What Skyward calls itself as a browser: the desktop identity, so a page
+/// comes as it would to a computer, not as a script-made one for phones.
+const USER_AGENT: &str = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36";
+
+/// The most of one page that is read.
+const MAX_PAGE: u64 = 8 << 20;
+
+/// The most pictures one page shows.
+const MAX_IMAGES: usize = 64;
+
+/// The most of one picture that is read.
+const MAX_IMAGE: u64 = 12 << 20;
+
+/// Read `url` into a page, its pictures and all.
+pub fn fetch(agent: &ureq::Agent, url: &str) -> Result<Loaded, Fail> {
+    use ureq::ResponseExt;
+    let mut response = agent
+        .get(url)
+        .header("User-Agent", USER_AGENT)
+        .header("Accept", "text/html,application/xhtml+xml,image/*,*/*;q=0.8")
+        .header("Accept-Language", "zh-CN,zh;q=0.9,en;q=0.8")
+        .call()
+        .map_err(|e| Fail::Why(format!("打开连接失败：{e}")))?;
+    let status = response.status().as_u16();
+    if !(200..400).contains(&status) {
+        return Err(Fail::Why(format!("服务器应答 {status}")));
+    }
+    let final_url = response.get_uri().to_string();
+    let kind = response
+        .headers()
+        .get("content-type")
+        .and_then(|v| v.to_str().ok())
+        .map(|s| s.to_ascii_lowercase())
+        .unwrap_or_default();
+    let mut bytes = Vec::new();
+    response
+        .body_mut()
+        .with_config()
+        .limit(MAX_PAGE)
+        .reader()
+        .take(MAX_PAGE)
+        .read_to_end(&mut bytes)
+        .map_err(|e| Fail::Why(format!("读取网页失败：{e}")))?;
+    let is_page = kind.is_empty()
+        || kind.contains("text/html")
+        || kind.contains("application/xhtml")
+        || kind.contains("text/plain")
+        || kind.contains("application/json");
+    if !is_page {
+        return Err(Fail::Download { url: final_url.clone(), name: download_name(&final_url, &kind), kind });
+    }
+    // A page is read in the character set its server names, or the one its
+    // own first lines do; UTF-8 when it says nothing.
+    let charset = charset_of(&kind, &bytes);
+    let text = decode(&bytes, charset.as_deref());
+    let doc = html::parse(&text);
+    let title = doc.elements("title").first().map(|&t| doc.text_of(t).trim().to_string()).unwrap_or_default();
+    let base = doc
+        .elements("base")
+        .first()
+        .and_then(|&b| doc.attr(b, "href"))
+        .map(|href| layout::resolve(&final_url, href))
+        .unwrap_or_else(|| final_url.clone());
+    let mut doc = doc;
+    // A page that is a script's shell — an app that builds itself as it
+    // runs — is shown as what it says about itself: its name, its words,
+    // its own pictures, and the way in to the rest.
+    if thin(&doc) {
+        eprintln!("web: {} chars of text, no pictures: summarizing", visible_text_len(&doc));
+        summarize(&mut doc, &title, &base);
+    } else {
+        eprintln!("web: {} chars of text, {} pictures", visible_text_len(&doc), doc.elements("img").len());
+    }
+    let images = load_images(agent, &doc, &base);
+    Ok(Loaded { url: final_url, title, doc, images })
+}
+
+/// The name a download from `url` is saved as: what the URL names, or a
+/// name made from its last part.
+pub fn download_name(url: &str, kind: &str) -> String {
+    let path = url.split(['?', '#']).next().unwrap_or(url);
+    let name = path.trim_end_matches('/').rsplit('/').next().unwrap_or("");
+    let name = if name.is_empty() || !name.contains('.') { String::new() } else { name.to_string() };
+    let name = url_decode(&name);
+    let name = name.replace(['/', '\\', ':', '*', '?', '"', '<', '>', '|'], "_");
+    if name.is_empty() {
+        let ext = if kind.contains("zip") {
+            "zip"
+        } else if kind.contains("image/png") {
+            "png"
+        } else if kind.contains("image/jpeg") {
+            "jpg"
+        } else {
+            "bin"
+        };
+        return format!("download.{ext}");
+    }
+    name
+}
+
+/// The characters of text a page shows, outside its head and its scripts.
+fn visible_text_len(doc: &html::Document) -> usize {
+    let mut n = 0;
+    let mut todo = vec![doc.root];
+    while let Some(node) = todo.pop() {
+        let entry = &doc.nodes[node];
+        if matches!(entry.tag.as_str(), "script" | "style" | "head" | "title" | "template") {
+            continue;
+        }
+        if entry.tag.is_empty() {
+            n += entry.text.chars().count();
+        }
+        todo.extend(entry.children.iter().copied());
+    }
+    n
+}
+
+/// Whether a page has nothing to show of itself: the sites of apps that
+/// build their pages as they run carry only their name, and no picture.
+fn thin(doc: &html::Document) -> bool {
+    let pictures = doc
+        .elements("img")
+        .iter()
+        .filter(|&&n| doc.attr(n, "src").is_some_and(|s| !s.trim().is_empty()))
+        .count();
+    visible_text_len(doc) < 60 && pictures == 0
+}
+
+/// What a page says about itself, from the tags it fills for the other
+/// sites that show it: `name` or `property` naming `key`.
+fn meta_content(doc: &html::Document, key: &str) -> Option<String> {
+    for &meta in &doc.elements("meta") {
+        let name = doc.attr(meta, "name").or_else(|| doc.attr(meta, "property")).unwrap_or("");
+        if name.eq_ignore_ascii_case(key) {
+            if let Some(content) = doc.attr(meta, "content").map(str::trim) {
+                if !content.is_empty() {
+                    return Some(content.to_string());
+                }
+            }
+        }
+    }
+    None
+}
+
+/// The pictures a page sets as its own in its styles.
+fn css_images(doc: &html::Document, base: &str) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    let mut texts: Vec<String> = Vec::new();
+    for &style in &doc.elements("style") {
+        texts.push(doc.text_of(style));
+    }
+    for node in &doc.nodes {
+        if let Some(inline) = node.attrs.iter().find(|(k, _)| k == "style").map(|(_, v)| v.clone()) {
+            texts.push(inline);
+        }
+    }
+    for text in texts {
+        let mut rest = text.as_str();
+        while let Some(at) = rest.find("url(") {
+            let after = &rest[at + 4..];
+            let Some(end) = after.find(')') else { break };
+            let url = after[..end].trim().trim_matches(|c| c == '"' || c == '\'').trim();
+            rest = &after[end..];
+            if url.is_empty() || url.starts_with("data:") {
+                continue;
+            }
+            let lower = url.to_ascii_lowercase();
+            let image = [".png", ".jpg", ".jpeg", ".webp", ".gif", ".avif"].iter().any(|ext| lower.contains(ext))
+                || lower.contains("image/");
+            if !image {
+                continue;
+            }
+            let whole = layout::resolve(base, url);
+            if whole.starts_with("http") && !out.contains(&whole) {
+                out.push(whole);
+            }
+            if out.len() >= 6 {
+                return out;
+            }
+        }
+    }
+    out
+}
+
+/// Show a script's shell as the page it says it is.
+fn summarize(doc: &mut html::Document, title: &str, base: &str) {
+    // The page's body, or what holds it where the page writes none.
+    let body = doc
+        .nodes
+        .iter()
+        .position(|n| n.tag == "body")
+        .or_else(|| doc.nodes.iter().position(|n| n.tag == "html"))
+        .unwrap_or(doc.root);
+    let description = meta_content(doc, "description").unwrap_or_default();
+    let og = meta_content(doc, "og:image").unwrap_or_default();
+    let mut noscript = String::new();
+    for &n in &doc.elements("noscript") {
+        let text = doc.text_of(n);
+        let text = squeeze(&text);
+        if !text.is_empty() {
+            noscript.push_str(&text);
+            noscript.push('\n');
+        }
+    }
+    let mut links: Vec<(String, String)> = Vec::new();
+    for &a in &doc.elements("a") {
+        let Some(href) = doc.attr(a, "href").map(|h| h.trim().to_string()) else { continue };
+        if href.is_empty() || href.starts_with('#') || href.starts_with("javascript:") {
+            continue;
+        }
+        let text = squeeze(&doc.text_of(a));
+        if text.is_empty() || text.chars().count() > 40 {
+            continue;
+        }
+        let url = layout::resolve(base, &href);
+        if !url.starts_with("http") || links.iter().any(|(u, _)| *u == url) {
+            continue;
+        }
+        links.push((url, text));
+        if links.len() >= 40 {
+            break;
+        }
+    }
+    let mut pictures: Vec<String> = Vec::new();
+    if og.starts_with("http") {
+        pictures.push(og);
+    }
+    for url in css_images(doc, base) {
+        if pictures.len() < 4 && !pictures.contains(&url) {
+            pictures.push(url);
+        }
+    }
+    doc.clear(body);
+    if !title.trim().is_empty() {
+        doc.add(body, "h1", title.trim(), Vec::new());
+    }
+    if !description.trim().is_empty() {
+        doc.add(body, "p", &description, Vec::new());
+    }
+    if !noscript.trim().is_empty() {
+        doc.add(body, "p", noscript.trim(), Vec::new());
+    }
+    for url in pictures {
+        doc.add(body, "img", "", vec![("src".to_string(), url)]);
+    }
+    if !links.is_empty() {
+        let ul = doc.add(body, "ul", "", Vec::new());
+        for (url, text) in links {
+            let li = doc.add(ul, "li", "", Vec::new());
+            doc.add(li, "a", &text, vec![("href".to_string(), url)]);
+        }
+    }
+}
+
+/// The words of `text` with every run of space become one.
+fn squeeze(text: &str) -> String {
+    text.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+fn url_decode(text: &str) -> String {
+    let bytes = text.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b'%' && i + 2 < bytes.len() {
+            if let Ok(v) = u8::from_str_radix(&text[i + 1..i + 3], 16) {
+                out.push(v);
+                i += 3;
+                continue;
+            }
+        }
+        out.push(bytes[i]);
+        i += 1;
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+fn charset_of(kind: &str, bytes: &[u8]) -> Option<String> {
+    if let Some(at) = kind.find("charset=") {
+        let rest = &kind[at + 8..];
+        let label = rest.split([';', ' ']).next().unwrap_or("").trim_matches('"').to_string();
+        if !label.is_empty() {
+            return Some(label);
+        }
+    }
+    let head = String::from_utf8_lossy(&bytes[..bytes.len().min(4096)]).to_ascii_lowercase();
+    let at = head.find("charset=")?;
+    let rest = &head[at + 8..];
+    let label: String = rest
+        .chars()
+        .take_while(|c| c.is_ascii_alphanumeric() || *c == '-' || *c == '_')
+        .collect();
+    if label.is_empty() {
+        None
+    } else {
+        Some(label)
+    }
+}
+
+fn decode(bytes: &[u8], charset: Option<&str>) -> String {
+    let label = charset.unwrap_or("utf-8");
+    if label.eq_ignore_ascii_case("utf-8") || label.eq_ignore_ascii_case("utf8") {
+        return String::from_utf8_lossy(bytes).into_owned();
+    }
+    match encoding_rs::Encoding::for_label(label.as_bytes()) {
+        Some(encoding) => {
+            let (text, _, _) = encoding.decode(bytes);
+            text.into_owned()
+        }
+        None => String::from_utf8_lossy(bytes).into_owned(),
+    }
+}
+
+fn load_images(agent: &ureq::Agent, doc: &html::Document, base: &str) -> image::Store {
+    let mut urls: Vec<String> = Vec::new();
+    for node in doc.elements("img") {
+        let src = doc.attr(node, "src").or_else(|| doc.attr(node, "data-src")).or_else(|| doc.attr(node, "data-original"));
+        let Some(src) = src else { continue };
+        let src = src.trim();
+        if src.is_empty() || src.starts_with("data:") {
+            continue;
+        }
+        let url = layout::resolve(base, src);
+        if !(url.starts_with("http://") || url.starts_with("https://")) {
+            continue;
+        }
+        if !urls.iter().any(|u| *u == url) {
+            urls.push(url);
+        }
+        if urls.len() >= MAX_IMAGES {
+            break;
+        }
+    }
+    let mut store = image::Store::default();
+    let mut pics: Vec<Option<image::Picture>> = vec![None; urls.len()];
+    if !urls.is_empty() {
+        let threads = urls.len().min(8);
+        let got = std::sync::Mutex::new(Vec::new());
+        std::thread::scope(|scope| {
+            for t in 0..threads {
+                let urls = &urls;
+                let got = &got;
+                scope.spawn(move || {
+                    let mut mine = Vec::new();
+                    let mut i = t;
+                    while i < urls.len() {
+                        if let Some(pic) = get_image(agent, &urls[i]) {
+                            mine.push((i, pic));
+                        }
+                        i += threads;
+                    }
+                    got.lock().expect("no panic holds the pictures").extend(mine);
+                });
+            }
+        });
+        for (i, pic) in got.into_inner().expect("no panic holds the pictures") {
+            pics[i] = Some(pic);
+        }
+    }
+    for (url, pic) in urls.into_iter().zip(pics) {
+        store.push(url, pic);
+    }
+    store
+}
+
+fn get_image(agent: &ureq::Agent, url: &str) -> Option<image::Picture> {
+    let mut response = agent.get(url).header("User-Agent", USER_AGENT).call().ok()?;
+    if !(200..300).contains(&response.status().as_u16()) {
+        return None;
+    }
+    let mut bytes = Vec::new();
+    response.body_mut().with_config().limit(MAX_IMAGE).reader().take(MAX_IMAGE).read_to_end(&mut bytes).ok()?;
+    image::decode(&bytes)
+}
+
+/// A page laid out: what to draw and where, and where its links go.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Page {
+    pub url: String,
+    pub title: String,
+    /// The page's width and height in the panel's pixels.
+    pub width: f32,
+    pub height: f32,
+    pub bg: Rgba,
+    pub items: Vec<Item>,
+    pub links: Vec<Link>,
+    pub images: Arc<image::Store>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum Item {
+    /// A run of text, its baseline `baseline` pixels down.
+    Text { x: f32, baseline: f32, text: String, px: f32, weight: u16, color: Rgba, mono: bool },
+    /// A picture, from `Page::images`.
+    Image { x: f32, y: f32, w: f32, h: f32, pic: usize },
+    Rect { x: f32, y: f32, w: f32, h: f32, color: Rgba },
+    Rule { x0: f32, y0: f32, x1: f32, y1: f32, t: f32, color: Rgba },
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Link {
+    pub rect: Rect,
+    pub href: String,
+}
+
+impl Page {
+    pub fn lay_out(loaded: Loaded, fonts: &Fonts, width: f32) -> Page {
+        layout::lay_out(loaded, fonts, width)
+    }
+
+    /// Where a tap at (`x`, `y`) in the page's pixels goes, if it lands on a
+    /// link.
+    pub fn link_at(&self, x: f32, y: f32) -> Option<String> {
+        self.links.iter().find(|l| x >= l.rect.x && x <= l.rect.x + l.rect.w && y >= l.rect.y && y <= l.rect.y + l.rect.h).map(|l| l.href.clone())
+    }
+
+    /// Draw the page into `c`, which may hold only a band of it.
+    pub fn paint(&self, c: &mut Canvas, fonts: &Fonts) {
+        self.paint_at(c, fonts, 0.0, 0.0);
+    }
+
+    /// [`Page::paint`], the page's top left corner at (`dx`, `dy`).
+    pub fn paint_at(&self, c: &mut Canvas, fonts: &Fonts, dx: f32, dy: f32) {
+        let held = c.held();
+        let bold = fonts.face(620.0).ok();
+        for item in &self.items {
+            match item {
+                Item::Rect { x, y, w, h, color } => {
+                    let (x, y) = (*x + dx, *y + dy);
+                    if y + *h < held.start as f32 || y > held.end as f32 {
+                        continue;
+                    }
+                    c.fill_rect(x, y, *w, *h, *color);
+                }
+                Item::Text { x, baseline, text, px, weight, color, mono } => {
+                    let face = if *mono {
+                        &fonts.mono
+                    } else if *weight >= 600 {
+                        bold.as_ref().unwrap_or(&fonts.body)
+                    } else {
+                        &fonts.body
+                    };
+                    let baseline = *baseline + dy;
+                    if baseline < held.start as f32 - *px * 1.6 || baseline > held.end as f32 + *px * 0.6 {
+                        continue;
+                    }
+                    c.text(face, text, *x + dx, baseline, *px, *color, None);
+                }
+                Item::Image { x, y, w, h, pic } => {
+                    let (x, y) = (*x + dx, *y + dy);
+                    if y + *h < held.start as f32 || y > held.end as f32 {
+                        continue;
+                    }
+                    if let Some(Some(pic)) = self.images.pics.get(*pic) {
+                        image::draw(c, pic, x, y, *w, *h);
+                    }
+                }
+                Item::Rule { x0, y0, x1, y1, t, color } => {
+                    let (y0, y1) = (*y0 + dy, *y1 + dy);
+                    if y0 < held.start as f32 - *t || y0 > held.end as f32 + *t {
+                        continue;
+                    }
+                    c.line(*x0 + dx, y0, *x1 + dx, y1, *t, *color);
+                }
+            }
+        }
+    }
+}
