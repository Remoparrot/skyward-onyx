diff --git a/crates/skyward-net/examples/fetch.rs b/crates/skyward-net/examples/fetch.rs
new file mode 100644
index 0000000..f9280c1
--- /dev/null
+++ b/crates/skyward-net/examples/fetch.rs
@@ -0,0 +1,54 @@
+//! Download a package the way the updater does, for trying the parallel
+//! connections on a phone:
+//!
+//!   fetch <url> <sha256> <path>
+//!
+//! With a fourth word `single`, one connection takes the whole file, for
+//! comparing with the parallel fetch.
+
+use std::net::Ipv4Addr;
+use std::path::Path;
+use std::sync::atomic::AtomicBool;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use skyward_net::download::{self, Progress, Sum};
+
+fn main() -> anyhow::Result<()> {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let (url, sum, path, single) = match args.as_slice() {
+        [url, sum, path] => (url.clone(), sum.clone(), path.clone(), false),
+        [url, sum, path, mode] => (url.clone(), sum.clone(), path.clone(), mode == "single"),
+        _ => anyhow::bail!("usage: fetch <url> <sha256> <path> [single]"),
+    };
+    // The DNS server the phone's WLAN gives; this runs from a shell beside
+    // the recovery, which has no resolver of its own.
+    let servers = Arc::new(Mutex::new(vec![Ipv4Addr::new(192, 168, 1, 1)]));
+    let agent = skyward_net::http::agent(servers);
+    let stop = AtomicBool::new(false);
+    let paused = AtomicBool::new(false);
+    let started = Instant::now();
+    let mut seen = (0u64, Instant::now());
+    let mut progress = |p: Progress| {
+        if let Progress::Downloading { done, total } = p {
+            let now = Instant::now();
+            if now.duration_since(seen.1) >= Duration::from_millis(500) {
+                let rate = done.saturating_sub(seen.0) as f64 / now.duration_since(seen.1).as_secs_f64();
+                println!("{done} / {total}  {:.2} MB/s", rate / 1e6);
+                seen = (done, now);
+            }
+        }
+    };
+    let result = if single {
+        download::save(&agent, &url, Path::new(&path), &stop, &paused, &mut progress)
+    } else {
+        download::fetch(&agent, &url, Path::new(&path), &Sum::Sha256(sum), &stop, &mut progress)
+    };
+    match result {
+        Ok(()) => {
+            println!("done in {:.1} s", started.elapsed().as_secs_f64());
+            Ok(())
+        }
+        Err(e) => anyhow::bail!("{e:#}"),
+    }
+}
