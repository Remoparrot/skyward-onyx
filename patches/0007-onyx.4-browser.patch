         progress(Progress::Downloading { done, total });
         std::thread::sleep(std::time::Duration::from_millis(80));
@@ -493,6 +503,56 @@ pub fn save(agent: &ureq::Agent, url: &str, path: &Path, stop: &AtomicBool, paus
 }
 
 /// The length a response says its body has.
+/// [`save`], over up to [`MAX_CONNECTIONS`] ranges at once where the
+/// server sends ranges, and over one connection where it will not.
+pub fn save_fast(agent: &ureq::Agent, url: &str, path: &Path, stop: &AtomicBool, paused: &AtomicBool, progress: &mut dyn FnMut(Progress)) -> Result<()> {
+    // One byte asked for alone tells how long the file is and whether the
+    // server will send it in parts at all.
+    let probe = agent.get(url).header("Range", "bytes=0-0").call().context("ask the server about the file")?;
+    let total = match probe.status().as_u16() {
+        206 => content_range_total(probe.headers()),
+        _ => None,
+    };
+    drop(probe);
+    let Some(total) = total.filter(|total| *total > 0) else {
+        return save(agent, url, path, stop, paused, progress);
+    };
+    let part = partial(path);
+    let dir = path.parent().context("a download's path is in a folder")?;
+    fs::create_dir_all(dir).with_context(|| format!("make {}", dir.display()))?;
+    let room = free(dir)?;
+    if total > room {
+        bail!(NoRoom { needed: total, free: room });
+    }
+    let file = OpenOptions::new().create(true).read(true).write(true).truncate(true).open(&part).with_context(|| format!("open {}", part.display()))?;
+    file.set_len(total).with_context(|| format!("make {} {} bytes long", part.display(), total))?;
+    drop(file);
+    let ranges = match fetch_ranges(agent, url, &part, total, stop, paused, progress) {
+        Ok(ranges) => ranges,
+        Err(e) => {
+            let _ = fs::remove_file(&part);
+            return Err(e);
+        }
+    };
+    if !ranges {
+        // The server answered the runs with the whole file: one connection
+        // takes it, as [`save`] does.
+        let _ = fs::remove_file(&part);
+        return save(agent, url, path, stop, paused, progress);
+    }
+    let file = OpenOptions::new().write(true).open(&part).with_context(|| format!("open {}", part.display()))?;
+    file.sync_all().with_context(|| format!("write {} through", part.display()))?;
+    drop(file);
+    fs::rename(&part, path).with_context(|| format!("name {} {}", part.display(), path.display()))
+}
+
+/// The length a `Content-Range` header names, as `bytes 0-0/12345` does.
+fn content_range_total(headers: &ureq::http::HeaderMap) -> Option<u64> {
+    let value = headers.get("content-range")?.to_str().ok()?;
+    let (_, total) = value.rsplit_once('/')?;
+    total.trim().parse::<u64>().ok().filter(|total| *total > 0)
+}
+
 pub(crate) fn content_length(headers: &ureq::http::HeaderMap) -> Option<u64> {
     headers.get(ureq::http::header::CONTENT_LENGTH)?.to_str().ok()?.parse().ok()
 }
