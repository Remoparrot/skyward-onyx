@@ -289,6 +290,15 @@ fn fetch_ranges(agent: &ureq::Agent, url: &str, part: &Path, total: u64, stop: &
             abort.store(true, Ordering::Relaxed);
             break;
         }
+        // Held, the connections wait where they are: what is not read yet
