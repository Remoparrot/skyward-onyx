+/// The weaver cannot be asked what it holds, so a blob bound to it cannot
+/// be opened here; what stands in for it is said with this, so a caller
+/// can tell it from a credential the weaver refused.
+#[derive(Debug)]
+struct WeaverUnusable;
+
+impl std::fmt::Display for WeaverUnusable {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "the phone's weaver is not answering, so what it holds cannot be asked for")
+    }
+}
