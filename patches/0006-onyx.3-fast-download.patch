+/// One run of the package, asked for again when the server is busy, the
+/// connection drops or the run comes short, and written where it belongs.
+#[allow(clippy::too_many_arguments)]
+fn run(agent: &ureq::Agent, url: &str, writer: &File, start: u64, end: u64, abort: &AtomicBool, done: &AtomicU64, whole: &AtomicBool) -> Result<()> {
+    let mut attempt = 0u32;
+    loop {
+        if abort.load(Ordering::Relaxed) {
+            bail!(crate::Stopped);
+        }
+        attempt += 1;
+        match one_run(agent, url, writer, start, end, abort, done, whole) {
+            Ok(()) => return Ok(()),
+            Err(e) if e.is::<crate::Stopped>() || whole.load(Ordering::Relaxed) => return Err(e),
+            Err(e) => {
+                if attempt >= RETRIES {
+                    return Err(anyhow::anyhow!("bytes {start}-{end}: {e:#}"));
+                }
+                // The server is busy or the connection is young; asking
+                // again a little later is what a slow link needs.
+                std::thread::sleep(std::time::Duration::from_millis(200 * u64::from(attempt) + u64::from(start % 100)));
             }
-            let n = body.read(&mut buf).context("download the package")?;
-            if n == 0 {
-                bail!("the server stopped sending at {done} of {total} bytes");
+        }
+    }
+}
