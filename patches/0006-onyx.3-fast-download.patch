+/// One asking for a run: its bytes read and written as they come, and the
+/// count of what was written taken back if the run does not finish.
+fn one_run(agent: &ureq::Agent, url: &str, writer: &File, start: u64, end: u64, abort: &AtomicBool, done: &AtomicU64, whole: &AtomicBool) -> Result<()> {
+    let mut response = agent.get(url).header("Range", format!("bytes={start}-{end}")).call().with_context(|| format!("ask for bytes {start}-{end}"))?;
+    match response.status().as_u16() {
+        206 => {}
+        200 => {
+            // The whole package came for one run: the server keeps no
+            // ranges, so one connection takes the lot.
+            whole.store(true, Ordering::Relaxed);
+            abort.store(true, Ordering::Relaxed);
+            bail!("the server answered with the whole package");
+        }
+        status => bail!(Refused(status)),
+    }
+    let mut body = response.body_mut().with_config().limit(u64::MAX).reader();
+    let mut buf = vec![0u8; SEGMENT as usize];
+    let mut pos = start;
+    let mut written = 0u64;
+    while pos <= end {
+        if abort.load(Ordering::Relaxed) {
+            done.fetch_sub(written, Ordering::Relaxed);
+            bail!(crate::Stopped);
+        }
+        let n = match body.read(&mut buf) {
+            Ok(n) => n,
+            Err(e) => {
+                done.fetch_sub(written, Ordering::Relaxed);
+                return Err(e).context("download a run of the package");
             }
