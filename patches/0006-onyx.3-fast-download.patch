-            file.write_all(&buf[..n]).with_context(|| format!("write {}", part.display()))?;
-            hash.update(&buf[..n]);
-            done += n as u64;
-            progress(Progress::Downloading { done, total });
+        };
+        if n == 0 {
+            break;
         }
-        file.sync_all().with_context(|| format!("write {} through", part.display()))?;
+        let n = n.min((end + 1 - pos) as usize);
+        if let Err(e) = write_at(writer, &buf[..n], pos) {
+            done.fetch_sub(written, Ordering::Relaxed);
+            return Err(e).with_context(|| format!("write bytes {pos} of the package"));
+        }
+        pos += n as u64;
+        written += n as u64;
+        done.fetch_add(n as u64, Ordering::Relaxed);
     }
