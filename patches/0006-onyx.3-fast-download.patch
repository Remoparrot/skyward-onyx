+/// Write `buf` at `offset`, leaving the handle's own offset alone so the
+/// connections sharing it do not write over each other.
+#[cfg(unix)]
+fn write_at(file: &File, buf: &[u8], offset: u64) -> std::io::Result<()> {
+    use std::os::unix::fs::FileExt;
+    file.write_all_at(buf, offset)
 }
 
+#[cfg(windows)]
+fn write_at(file: &File, buf: &[u8], offset: u64) -> std::io::Result<()> {
+    use std::os::windows::fs::FileExt;
+    let mut at = offset;
+    let mut rest = buf;
+    while !rest.is_empty() {
+        let n = file.seek_write(rest, at)?;
+        if n == 0 {
+            return Err(std::io::Error::new(std::io::ErrorKind::WriteZero, "the package's file took nothing"));
+        }
+        at += n as u64;
+        rest = &rest[n..];
+    }
+    Ok(())
+}
