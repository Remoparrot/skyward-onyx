+/// The note that a call has arrived for an object this program serves.
+const BR_TRANSACTION: u32 = ioc(READ, b'r', 2, size_of::<TransactionData>());
+/// The note that another program has let an object of this one go.
+const BR_DEAD_BINDER: u32 = ioc(READ, b'r', 15, 8);
+/// Answer a call.
+const BC_REPLY: u32 = ioc(WRITE, b'c', 1, size_of::<TransactionData>());
+/// Tell the driver this thread takes calls rather than only making them.
+const BC_ENTER_LOOPER: u32 = ioc(0, b'c', 12, 0);
+
+/// The call is one-way, so nothing is written back for it.
+const TF_ONE_WAY: u32 = 0x1;
+
+/// The status an answer opens with when the call ended in an error, in the
+/// newer layout's own numbering; what went wrong follows it in words.
+const EXCEPTION_UNKNOWN: i32 = -1;
+
+/// Ask any object whether it is still there, which carries nothing at all.
+const PING: u32 = u32::from_be_bytes(*b"_PNG");
+
+/// The mark libbinder writes into the header of every call it makes, which
+/// this side steps over before the interface's name.
+const CALL_HEADER: i32 = i32::from_be_bytes(*b"RECO");
+
+/// What one call answers: the values the other side reads back, which open
+/// with the status the call ended with, and at most one object it is handed.
+pub struct Answer {
+    parcel: Parcel,
+    /// The address the object handed over, if one is, is served at.
+    address: u64,
+    given: Option<Box<dyn Served>>,
+    /// Whether the answer is one libbinder itself writes for the objects it
+    /// serves, which opens with the value rather than with a status.
+    bare: bool,
+}
+
+impl Answer {
+    /// Answer the way libbinder answers for itself: the value alone, with
+    /// no status in front of it.
+    pub fn bare(&mut self) {
+        self.parcel = Parcel::default();
+        self.bare = true;
+    }
+
+    pub fn i32(&mut self, v: i32) {
+        self.parcel.i32(v);
+    }
+
+    pub fn bool(&mut self, v: bool) {
+        self.parcel.bool(v);
+    }
+
+    pub fn blob(&mut self, v: &[u8]) {
+        self.parcel.blob(v);
+    }
+
+    pub fn string(&mut self, v: &str) {
+        self.parcel.string(v);
+    }
+
+    /// A run of strings, as the newer layout writes one: the count, then
+    /// each.
+    pub fn strings(&mut self, v: &[String]) {
+        self.parcel.i32(v.len() as i32);
+        for s in v {
+            self.parcel.string(s);
+        }
+    }
+
+    /// Nothing where a value may be left out.
+    pub fn none(&mut self) {
+        self.parcel.none();
+    }
+
+    /// Hand `object` over as what this call answers with, served from here
+    /// on at the address this answer was given.
+    pub fn give(&mut self, object: Box<dyn Served>) {
+        self.parcel.object(self.address);
+        self.given = Some(object);
+    }
+}
+
+/// An object this program serves: what takes the calls that arrive for it.
+pub trait Served {
+    fn serve(&mut self, code: u32, data: &mut Reader<'_>, answer: &mut Answer) -> Result<()>;
+}
+
+/// The objects served here, by the address the driver hands a call back
+/// with. One table per thread: a program that both takes calls and makes
+/// them waits and answers on the same thread, so a call that arrives while
+/// it waits for an answer of its own is answered from the same table.
+type ServedHere = Rc<RefCell<Box<dyn Served>>>;
+
+thread_local! {
+    static OBJECTS: RefCell<HashMap<u64, ServedHere>> = RefCell::new(HashMap::new());
+    static NEXT: Cell<u64> = const { Cell::new(1) };
+}
+
+/// The address the next object handed over is served at.
+fn next_address() -> u64 {
+    NEXT.with(|next| {
+        let address = next.get();
+        next.set(address + 1);
+        address
+    })
+}
+
+/// The object served at `address`, if any, so a call can be answered
+/// without holding the table itself while the object runs.
+fn served(address: u64) -> Option<ServedHere> {
+    OBJECTS.with(|objects| objects.borrow().get(&address).cloned())
+}
+
+/// Serve `object` at `address` from now on.
+fn serve_here(address: u64, object: Box<dyn Served>) {
+    OBJECTS.with(|objects| objects.borrow_mut().insert(address, Rc::new(RefCell::new(object))));
+}
+
+/// What a program that takes calls holds: its one end of the driver, which
+/// both takes calls and makes them. An object is served on the end that
+/// sent it, so a callback handed to another service only comes back here.
+pub struct Server {
+    binder: &'static Binder,
+}
+
+impl Server {
+    /// A program that takes calls, before any object is served.
+    pub fn new() -> Result<Server> {
+        let binder: &'static Binder =
+            Box::leak(Box::new(Binder::open().context("open the driver to take calls")?));
+        Ok(Server { binder })
+    }
+
+    /// The end of the driver this server holds, for calls it makes of its
+    /// own while answering.
+    pub fn binder(&self) -> &'static Binder {
+        self.binder
+    }
+
+    /// Serve `object` from now on, at an address of its own: a call that
+    /// names that address is answered here.
+    pub fn keep(&mut self, object: Box<dyn Served>) -> u64 {
+        let address = next_address();
+        serve_here(address, object);
+        address
+    }
+
+    /// Take `name` in the service directory for the object served at
+    /// `address`, so others reach it by that name.
+    pub fn register(&self, name: &str, address: u64) -> Result<()> {
+        crate::service::publish(self.binder, name, address).with_context(|| format!("serve {name}"))
+    }
+
+    /// Start taking calls on this thread.
+    pub fn enter(&self) -> Result<()> {
+        self.binder.tell(BC_ENTER_LOOPER, &[]).context("start taking calls")
+    }
+
+    /// Wait for a call and answer it, for as long as the program runs.
+    pub fn serve(&mut self) -> Result<()> {
+        let mut read = [0u8; 512];
+        loop {
+            let mut bwr = WriteRead { read_size: read.len() as u64, read_buffer: read.as_mut_ptr() as u64, ..WriteRead::default() };
+            unsafe { call(&self.binder.file, BINDER_WRITE_READ, &mut bwr as *mut WriteRead as *mut libc::c_void) }
+                .context("wait for a call")?;
+            self.take(&read[..bwr.read_consumed as usize])?;
+        }
+    }
+
+    /// What the driver said back: a call to answer, or a notice to step
+    /// over.
+    fn take(&mut self, mut said: &[u8]) -> Result<()> {
+        while said.len() >= 4 {
+            let note = u32::from_ne_bytes(said[..4].try_into().expect("four bytes"));
+            said = &said[4..];
+            let mut skip = |n: usize| {
+                let (head, rest) = said.split_at(n.min(said.len()));
+                said = rest;
+                head
+            };
+            match note {
+                BR_NOOP | BR_TRANSACTION_COMPLETE | BR_SPAWN_LOOPER | BR_DEAD_REPLY | BR_FAILED_REPLY | BR_FROZEN_REPLY => {}
+                BR_INCREFS | BR_ACQUIRE | BR_RELEASE | BR_DECREFS => {
+                    skip(16);
+                }
+                BR_DEAD_BINDER => {
+                    skip(8);
+                }
+                BR_ERROR => {
+                    let raw = skip(4);
+                    let code = i32::from_ne_bytes(raw.try_into().unwrap_or([0; 4]));
+                    bail!("the driver reported error {code} while taking calls");
+                }
+                BR_TRANSACTION => {
+                    let raw = skip(size_of::<TransactionData>());
+                    let td: TransactionData = unsafe { std::ptr::read_unaligned(raw.as_ptr().cast()) };
+                    let data = unsafe { std::slice::from_raw_parts(td.buffer as *const u8, td.data_size as usize) };
+                    dispatch(self.binder, td.target, td.code, td.flags, data)?;
+                    self.binder.free(td.buffer)?;
+                }
+                other => bail!("the driver said {other:#x}, which Skyward does not know"),
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Answer the call `code` made on the object served at `target`, whether it
+/// came in to a thread waiting for calls or to one waiting for an answer of
+/// its own: the hardware service asks a callback what it is as it is
+/// started, before it answers the call that started it.
+fn dispatch(binder: &Binder, target: u64, code: u32, flags: u32, data: &[u8]) -> Result<()> {
+    let address = next_address();
+    let mut answer = Answer { parcel: Parcel::default(), address, given: None, bare: false };
+    answer.parcel.i32(0);
+    // The driver's own ping asks only whether the object is still there:
+    // it carries nothing and is answered with nothing.
+    if data.is_empty() && code == PING {
+        return match flags & TF_ONE_WAY != 0 {
+            true => Ok(()),
+            false => binder.reply(&answer.parcel),
+        };
+    }
+    let mut read = Reader::new(data);
+    // Every call opens with the header libbinder writes, then the name
+    // of the interface it is for.
+    let opened = (|| -> Result<()> {
+        read.i32().context("read a call's header")?;
+        read.i32().context("read a call's header")?;
+        let header = read.i32().context("read a call's header")?;
+        if header != CALL_HEADER {
+            read.go(8).context("go back to the interface's name")?;
+        }
+        read.string().context("read the interface a call is for")?;
+        Ok(())
+    })();
+    if opened.is_err() {
+        read = Reader::new(data);
+    }
+    let outcome = match served(target) {
+        Some(object) => object.borrow_mut().serve(code, &mut read, &mut answer),
+        None => bail!("a call came for {target}, which this program does not serve"),
+    };
+    if let Err(e) = outcome {
+        answer.parcel = Parcel::default();
+        answer.bare = false;
+        answer.parcel.i32(EXCEPTION_UNKNOWN);
+        answer.parcel.string(&format!("{e:#}"));
+        answer.given = None;
+    }
+    if flags & TF_ONE_WAY != 0 {
+        return Ok(());
+    }
+    if let Some(object) = answer.given.take() {
+        serve_here(answer.address, object);
+    }
+    binder.reply(&answer.parcel)
+}
+
+impl Binder {
+    /// Make a call that carries objects, which [`Binder::transact`] does
+    /// not: the driver is told where among the values they sit.
+    pub fn transact_carrying(&self, handle: u32, code: u32, data: &Parcel) -> Result<Reply<'_>> {
+        let offsets: Vec<u64> = data.objects().to_vec();
+        let td = TransactionData {
+            target: handle as u64,
+            code,
+            flags: TF_ACCEPT_FDS,
+            data_size: data.bytes().len() as u64,
+            offsets_size: (offsets.len() * 8) as u64,
+            buffer: data.bytes().as_ptr() as u64,
+            offsets: if offsets.is_empty() { 0 } else { offsets.as_ptr() as u64 },
+            ..TransactionData::default()
+        };
+        self.deliver(BC_TRANSACTION, &td, &[])
+    }
+}
