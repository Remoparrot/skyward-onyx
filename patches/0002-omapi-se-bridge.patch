+++ b/crates/skyward/src/omapi.rs
@@ -0,0 +1,536 @@
+//! The service the phone's secure element is reached through, which a
+//! recovery does not have. The weaver, in the secure element, keeps each
+//! user's secret in a slot, and the only way the phone's own program
+//! reaches that slot is OMAPI: it asks the service registered as
+//! `omapiSeService` for a reader, opens a channel on it, and sends the
+//! applet's own bytes down that channel.
+//!
+//! In a running system that service is part of the system server, which a
+//! recovery never starts. So the recovery serves the few calls the weaver
+//! makes and passes them on to the secure element's own hardware service,
+//! which the recovery does run: `android.hardware.secure_element.
+//! ISecureElement/eSE1`.
+
+use anyhow::{bail, Context, Result};
+use skyward_binder::driver::{Answer, Binder, Handle, Server, Served};
+use skyward_binder::parcel::{Parcel, Reader};
+use skyward_binder::service;
+use skyward_binder::status;
+use std::cell::Cell;
+
+/// The name the weaver looks the service up by: not the one a running
+/// system's own programs use, but the one the phone's description of its
+/// interfaces names, which is the only one a look-up from a vendor process
+/// finds.
+pub const NAME: &str = "android.se.omapi.ISecureElementService/default";
+
+/// The secure element's own hardware service, as it is registered here.
+const ELEMENTS: &str = "android.hardware.secure_element.ISecureElement/eSE1";
+
+/// The interface that service serves, which is what a call to it is made
+/// out to: the registered name is not it.
+const SE_IFACE: &str = "android.hardware.secure_element.ISecureElement";
+
+/// The interface the hardware service tells this program how it stands
+/// through: it is handed one object as it is started, and calls it.
+const SE_CALLBACK: &str = "android.hardware.secure_element.ISecureElementCallback";
+
+/// The reader the service offers: the secure element the phone carries,
+/// which its own system names eSE1 as well.
+const READER: &str = "eSE1";
+
+/// The names the interfaces are known by in a call's header.
+const SERVICE: &str = "android.se.omapi.ISecureElementService";
+const READER_IFACE: &str = "android.se.omapi.ISecureElementReader";
+const SESSION_IFACE: &str = "android.se.omapi.ISecureElementSession";
+const CHANNEL_IFACE: &str = "android.se.omapi.ISecureElementChannel";
+
+/// What the directory and libbinder ask of every object: which process
+/// serves it, which interface it serves, which version of it, and which
+/// hash that version was frozen at.
+const WHICH_PROCESS: u32 = u32::from_be_bytes(*b"_PID");
+const WHICH_INTERFACE: u32 = u32::from_be_bytes(*b"_NTF");
+const WHICH_VERSION: u32 = 0x00ff_ffff;
+const WHICH_HASH: u32 = 0xf0ff_ffff;
+
+/// How the service's own methods are numbered, in the order the interface
+/// declares them, from one rather than from none.
+const GET_READERS: u32 = 1;
+const GET_READER: u32 = 2;
+const IS_PRESENT: u32 = 3;
+
+/// The reader's.
+const READER_PRESENT: u32 = 1;
+const OPEN_SESSION: u32 = 2;
+const CLOSE_SESSIONS: u32 = 3;
+
+/// A session's.
+const SESSION_ATR: u32 = 1;
+const SESSION_CLOSE: u32 = 2;
+const SESSION_IS_CLOSED: u32 = 3;
+const SESSION_OPEN_BASIC: u32 = 4;
+const SESSION_OPEN_LOGICAL: u32 = 5;
+
+/// A channel's.
+const CHANNEL_CLOSE: u32 = 1;
+const CHANNEL_IS_CLOSED: u32 = 2;
+const CHANNEL_IS_BASIC: u32 = 3;
+const CHANNEL_SELECT_RESPONSE: u32 = 4;
+const CHANNEL_TRANSMIT: u32 = 5;
+
+/// How the hardware service's own methods are numbered: the order its own
+/// proxy lays them out in, which is not the order this program would
+/// guess.
+const SE_CLOSE_CHANNEL: u32 = 1;
+const SE_ATR: u32 = 2;
+const SE_INIT: u32 = 3;
+const SE_PRESENT: u32 = 4;
+const SE_OPEN_BASIC: u32 = 5;
+const SE_OPEN_LOGICAL: u32 = 6;
+const SE_TRANSMIT: u32 = 8;
+
+/// What the hardware service calls its callback with: whether the card is
+/// there, and why it is not.
+const CALLBACK_STATE: u32 = 1;
+
+/// The address this program serves its callback at, and whether the
+/// hardware service has taken it and so may be asked anything.
+thread_local! {
+    static CALLBACK: Cell<u64> = const { Cell::new(0) };
+    static READY: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Every call this program has answered, in the kernel log, so a weaver
+/// that still will not come up can be followed.
+fn tell(what: &str) {
+    let _ = skyward_sys::kmsg(&format!("omapi: {what}"));
+}
+
+/// The end of the driver the hardware service is reached through. It
+/// outlives every object served here, and it is the same end the service
+/// itself is served on: the driver hands a callback back only to the end
+/// that sent it.
+thread_local! {
+    static OUT: Cell<Option<&'static Binder>> = const { Cell::new(None) };
+}
+
+fn out() -> Result<&'static Binder> {
+    OUT.with(|slot| match slot.get() {
+        Some(binder) => Ok(binder),
+        None => {
+            let binder: &'static Binder =
+                Box::leak(Box::new(Binder::open().context("open the driver the hardware services are reached through")?));
+            slot.set(Some(binder));
+            Ok(binder)
+        }
+    })
+}
+
+/// The hardware service's own handle, looked up afresh for each call: it
+/// registers before this program starts, and a look-up is one call.
+fn elements() -> Result<Handle<'static>> {
+    let binder = out()?;
+    service::find(binder, ELEMENTS)?.with_context(|| format!("{ELEMENTS} has not registered, so the secure element cannot be reached"))
+}
+
+/// Ask the hardware service for one thing, and give back what it answered
+/// once the status in front of it is read.
+fn ask<T>(code: u32, call: &Parcel, read: impl FnOnce(&mut Reader<'_>) -> Result<T>) -> Result<T> {
+    ready()?;
+    let handle = elements()?;
+    let reply = match call.objects().is_empty() {
+        true => out()?.transact(handle.raw(), code, call)?,
+        false => out()?.transact_carrying(handle.raw(), code, call)?,
+    };
+    let mut reader = reply.read();
+    status::ok(&mut reader).with_context(|| format!("the hardware service answered method {code}"))?;
+    read(&mut reader)
+}
+
+/// Make sure the hardware service has taken this program's callback, which
+/// is what it waits for before it answers anything else.
+fn ready() -> Result<()> {
+    if READY.with(Cell::get) {
+        return Ok(());
+    }
+    let callback = CALLBACK.with(Cell::get);
+    let handle = elements()?;
+    let mut call = Parcel::call(SE_IFACE);
+    call.object(callback);
+    let reply = out()?.transact_carrying(handle.raw(), SE_INIT, &call)?;
+    let mut read = reply.read();
+    status::ok(&mut read).context("the hardware service took the callback it is started with")?;
+    READY.with(|r| r.set(true));
+    tell("the hardware service is ready");
+    Ok(())
+}
+
+/// What is served here: the service itself, and what it hands out.
+enum Object {
+    /// The service, which knows the one reader.
+    Service,
+    /// The reader, through which sessions are opened.
+    Reader,
+    /// What the hardware service tells this program how it stands through.
+    Callback,
+    /// A session on the secure element, with the card's own answer.
+    Session { atr: Vec<u8> },
+    /// A channel on that session, held by the hardware service under its
+    /// own number.
+    Channel { number: u8, basic: bool, select: Vec<u8> },
+}
+
+impl Served for Object {
+    fn serve(&mut self, code: u32, data: &mut Reader<'_>, answer: &mut Answer) -> Result<()> {
+        if code != WHICH_INTERFACE && code != WHICH_VERSION && code != WHICH_HASH && code != WHICH_PROCESS {
+            tell(&format!("call {code} arrived for {}", self.name()));
+        }
+        let outcome = match self {
+            Object::Service => serve_service(code, data, answer),
+            Object::Reader => serve_reader(code, answer),
+            Object::Callback => serve_callback(code, data, answer),
+            Object::Session { atr } => serve_session(code, data, atr, answer),
+            Object::Channel { number, basic, select } => serve_channel(code, data, *number, *basic, select, answer),
+        };
+        if let Err(e) = &outcome {
+            tell(&format!("call {code} for {} failed: {e:#}", self.name()));
+        }
+        outcome
+    }
+}
+
+impl Object {
+    fn name(&self) -> &'static str {
+        match self {
+            Object::Service => "the service",
+            Object::Reader => "the reader",
+            Object::Callback => "the callback",
+            Object::Session { .. } => "a session",
+            Object::Channel { .. } => "a channel",
+        }
+    }
+}
+
+/// Answer what the directory and libbinder ask of every object before any
+/// interface sees the call.
+fn answer_everything(code: u32, interface: &str, answer: &mut Answer) -> bool {
+    match code {
+        WHICH_INTERFACE => {
+            answer.bare();
+            answer.string(interface);
+            true
+        }
+        WHICH_VERSION => {
+            answer.bare();
+            answer.i32(1);
+            true
+        }
+        WHICH_HASH => {
+            answer.bare();
+            answer.string("");
+            true
+        }
+        WHICH_PROCESS => {
+            answer.bare();
+            answer.i32(std::process::id() as i32);
+            true
+        }
+        _ => false,
+    }
+}
+
+fn serve_service(code: u32, data: &mut Reader<'_>, answer: &mut Answer) -> Result<()> {
+    if answer_everything(code, SERVICE, answer) {
+        return Ok(());
+    }
+    match code {
+        GET_READERS => {
+            tell("the service is asked for its readers");
+            answer.strings(&[READER.to_string()]);
+            Ok(())
+        }
+        IS_PRESENT => {
+            let name = data.string().context("read which reader is asked about")?;
+            tell(&format!("the service is asked whether {name} is present"));
+            answer.bool(name == READER && card_present()?);
+            Ok(())
+        }
+        GET_READER => {
+            let name = data.string().context("read which reader is asked for")?;
+            tell(&format!("the service is asked for the reader {name}"));
+            match name == READER {
+                true => {
+                    answer.give(Box::new(Object::Reader));
+                    Ok(())
+                }
+                false => {
+                    answer.none();
+                    Ok(())
+                }
+            }
+        }
+        other => bail!("the service has no method {other}"),
+    }
+}
+
+fn serve_reader(code: u32, answer: &mut Answer) -> Result<()> {
+    if answer_everything(code, READER_IFACE, answer) {
+        return Ok(());
+    }
+    match code {
+        READER_PRESENT => {
+            answer.bool(card_present()?);
+            Ok(())
+        }
+        OPEN_SESSION => {
+            tell("a session is opened on the secure element");
+            let atr = ask(SE_ATR, &Parcel::call(SE_IFACE), |r| r.blob().context("read the card's ATR"))?;
+            tell(&format!("the secure element answered an ATR of {} bytes: {}", atr.len(), hex(&atr)));
+            answer.give(Box::new(Object::Session { atr }));
+            Ok(())
+        }
+        CLOSE_SESSIONS => {
+            tell("every session on the secure element is closed");
+            Ok(())
+        }
+        other => bail!("the reader has no method {other}"),
+    }
+}
+
+fn serve_callback(code: u32, data: &mut Reader<'_>, answer: &mut Answer) -> Result<()> {
+    if answer_everything(code, SE_CALLBACK, answer) {
+        return Ok(());
+    }
+    match code {
+        CALLBACK_STATE => {
+            let there = data.bool().unwrap_or(false);
+            let why = data.string().unwrap_or_default();
+            tell(&format!("the hardware service says the card is {}: {why}", if there { "there" } else { "not there" }));
+            Ok(())
+        }
+        other => bail!("the callback has no method {other}"),
+    }
+}
+
+fn serve_session(code: u32, data: &mut Reader<'_>, atr: &[u8], answer: &mut Answer) -> Result<()> {
+    if answer_everything(code, SESSION_IFACE, answer) {
+        return Ok(());
+    }
+    match code {
+        SESSION_ATR => {
+            answer.blob(atr);
+            Ok(())
+        }
+        SESSION_IS_CLOSED => {
+            answer.bool(false);
+            Ok(())
+        }
+        SESSION_CLOSE => Ok(()),
+        SESSION_OPEN_BASIC | SESSION_OPEN_LOGICAL => {
+            let aid = data.blob().context("read which applet a channel is asked for")?;
+            let p2 = data.byte().context("read the P2 the channel opens with")?;
+            // The byte after an array is one byte wide, not a whole word.
+            let basic = code == SESSION_OPEN_BASIC;
+            tell(&format!("a{} channel is asked for applet {} with p2 {p2}", if basic { " basic" } else { " logical" }, hex(&aid)));
+            let mut call = Parcel::call(SE_IFACE);
+            call.blob_tight(&aid);
+            call.byte(p2);
+            let select = ask(if basic { SE_OPEN_BASIC } else { SE_OPEN_LOGICAL }, &call, |r| {
+                r.blob().with_context(|| {
+                    if basic {
+                        "read what the card answered the channel it opened"
+                    } else {
+                        "read the logical channel the card opened"
+                    }
+                })
+            })?;
+            tell(&format!("the card answered the channel with {} bytes: {}", select.len(), hex(&select)));
+            answer.give(Box::new(Object::Channel { number: 0, basic, select }));
+            Ok(())
+        }
+        other => bail!("the session has no method {other}"),
+    }
+}
+
+fn serve_channel(
+    code: u32,
+    data: &mut Reader<'_>,
+    number: u8,
+    basic: bool,
+    select: &[u8],
+    answer: &mut Answer,
+) -> Result<()> {
+    if answer_everything(code, CHANNEL_IFACE, answer) {
+        return Ok(());
+    }
+    match code {
+        CHANNEL_TRANSMIT => {
+            let sent = data.blob().context("read what is sent down the channel")?;
+            tell(&format!("{} bytes are sent down the channel: {}", sent.len(), hex(&sent)));
+            let mut call = Parcel::call(SE_IFACE);
+            call.blob(&sent);
+            let back = ask(SE_TRANSMIT, &call, |r| r.blob().context("read what came back down the channel"))?;
+            tell(&format!("{} bytes came back: {}", back.len(), hex(&back)));
+            answer.blob(&back);
+            Ok(())
+        }
+        CHANNEL_IS_BASIC => {
+            answer.bool(basic);
+            Ok(())
+        }
+        CHANNEL_IS_CLOSED => {
+            answer.bool(false);
+            Ok(())
+        }
+        CHANNEL_SELECT_RESPONSE => {
+            answer.blob(select);
+            Ok(())
+        }
+        CHANNEL_CLOSE => {
+            let mut call = Parcel::call(SE_IFACE);
+            call.byte(number);
+            let _ = ask(SE_CLOSE_CHANNEL, &call, |_| Ok(()));
+            Ok(())
+        }
+        other => bail!("the channel has no method {other}"),
+    }
+}
+
+/// Ask the hardware service whether a card is there.
+fn card_present() -> Result<bool> {
+    ask(SE_PRESENT, &Parcel::call(SE_IFACE), |r| r.bool().context("read whether the card is there"))
+}
+
+/// Serve the service until the program ends.
+pub fn serve() -> Result<()> {
+    let mut server = Server::new()?;
+    // Everything this program says to the hardware service goes through the
+    // same end of the driver it takes calls on, so the callback it hands
+    // over comes back here rather than to a place nothing reads.
+    OUT.with(|slot| slot.set(Some(server.binder())));
+    let callback = server.keep(Box::new(Object::Callback));
+    CALLBACK.with(|c| c.set(callback));
+    READY.with(|r| r.set(false));
+    // Start the hardware service before offering the service: the weaver
+    // reads a service whose reader is not started as a service that cannot
+    // reach the card at all.
+    match ready() {
+        Ok(()) => tell("the hardware service is started before the service is offered"),
+        Err(e) => tell(&format!("the hardware service will not start yet: {e:#}")),
+    }
+    let address = server.keep(Box::new(Object::Service));
+    server.register(NAME, address)?;
+    tell("the service is registered");
+    server.enter()?;
+    server.serve()
+}
+
+/// Ask the hardware service what it is, and what it answers when called:
+/// what a recovery reaches before any of this is built on.
+pub fn probe() -> Result<()> {
+    let binder = out()?;
+    let handle = elements()?;
+    println!("{ELEMENTS} is up");
+    match service::pid(&handle) {
+        Ok(pid) => println!("it is served by process {pid}"),
+        Err(e) => println!("nothing says which process serves it: {e:#}"),
+    }
+    if let Ok(interface) = service::interface(&handle) {
+        println!("it serves {interface}");
+    }
+    match service::version(&handle, SE_IFACE) {
+        Ok(v) => println!("it serves version {v} of that interface"),
+        Err(e) => println!("it will not say which version it serves: {e:#}"),
+    }
+    for (what, code) in [("isCardPresent", SE_PRESENT), ("getAtr", SE_ATR)] {
+        let call = Parcel::call(SE_IFACE);
+        let _ = binder;
+        match binder.transact(handle.raw(), code, &call) {
+            Ok(reply) => {
+                let mut read = reply.read();
+                match status::ok(&mut read) {
+                    Ok(()) => {
+                        let left = reply.bytes().len() - read.here();
+                        println!("{what} (method {code}) answered; {left} bytes left: {}", hex(&reply.bytes()[read.here()..]));
+                    }
+                    Err(e) => println!("{what} (method {code}): {e:#}"),
+                }
+            }
+            Err(e) => println!("{what} (method {code}): {e:#}"),
+        }
+    }
+    println!("whether it is ready: {:?}", ready().map_err(|e| format!("{e:#}")));
+    // The look-up the weaver makes, made from its own account as well: a
+    // vendor process is not shown every service the phone has.
+    look(name_of_the_searcher());
+    Ok(())
+}
+
+/// The account the weaver's own program runs as, which its look-ups are
+/// made from.
+fn name_of_the_searcher() -> u32 {
+    2911
+}
+
+/// Ask for the service from this account and from the weaver's own.
+fn look(uid: u32) {
+    println!("--- asking for {NAME}");
+    for (what, code) in [("getService", 1u32), ("checkService", 2)] {
+        let mut call = Parcel::call("android.os.IServiceManager");
+        call.string(NAME);
+        match out().and_then(|b| b.transact(0, code, &call)) {
+            Ok(reply) => {
+                let mut read = reply.read();
+                match status::ok(&mut read) {
+                    Ok(()) => match read.object() {
+                        Ok(Some(handle)) => println!("  as root {what}: found it, handle {handle}"),
+                        Ok(None) => println!("  as root {what}: nothing"),
+                        Err(e) => println!("  as root {what}: {e:#}"),
+                    },
+                    Err(e) => println!("  as root {what}: {e:#}"),
+                }
+            }
+            Err(e) => println!("  as root {what}: {e:#}"),
+        }
+    }
+    unsafe {
+        let pid = libc::fork();
+        if pid == 0 {
+            if libc::setgid(uid) != 0 || libc::setuid(uid) != 0 {
+                println!("  could not become {uid}");
+                libc::_exit(1);
+            }
+            let binder = match Binder::open() {
+                Ok(b) => b,
+                Err(e) => {
+                    println!("  as {uid}: the driver would not open: {e:#}");
+                    libc::_exit(1);
+                }
+            };
+            for (what, code) in [("getService", 1u32), ("checkService", 2)] {
+                let mut call = Parcel::call("android.os.IServiceManager");
+                call.string(NAME);
+                match binder.transact(0, code, &call) {
+                    Ok(reply) => {
+                        let mut read = reply.read();
+                        match status::ok(&mut read) {
+                            Ok(()) => match read.object() {
+                                Ok(Some(handle)) => println!("  as {uid} {what}: found it, handle {handle}"),
+                                Ok(None) => println!("  as {uid} {what}: nothing"),
+                                Err(e) => println!("  as {uid} {what}: {e:#}"),
+                            },
+                            Err(e) => println!("  as {uid} {what}: {e:#}"),
+                        }
+                    }
+                    Err(e) => println!("  as {uid} {what}: {e:#}"),
+                }
+            }
+            libc::_exit(0);
+        }
+        libc::waitpid(pid, std::ptr::null_mut(), 0);
+    }
+}
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
