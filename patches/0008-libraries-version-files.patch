diff --git a/crates/skyward-ui/src/app/partitions.rs b/crates/skyward-ui/src/app/partitions.rs
new file mode 100644
index 0000000..43b7da9
--- /dev/null
+++ b/crates/skyward-ui/src/app/partitions.rs
@@ -0,0 +1,80 @@
+//! Whole partitions: what the phone's by-name table holds, flashing one
+//! from an image in internal storage, and writing one back into an image.
+
+use super::*;
+
+/// A partition the phone's by-name table holds.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Partition {
+    pub name: String,
+    pub device: String,
+    pub size: u64,
+}
+
+/// A partition and the slot variants it has, such as `boot`'s `boot_a`
+/// and `boot_b`, or a partition with one copy, such as `misc`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PartitionGroup {
+    pub base: String,
+    /// Places, in [`Partition`]s, of the copies the group holds.
+    pub variants: Vec<usize>,
+}
+
+/// The partitions gathered by their name without a slot suffix, in name
+/// order.
+pub fn groups(parts: &[Partition]) -> Vec<PartitionGroup> {
+    let mut map: std::collections::BTreeMap<String, Vec<usize>> = std::collections::BTreeMap::new();
+    for (k, part) in parts.iter().enumerate() {
+        let base = part.name.strip_suffix("_a").or_else(|| part.name.strip_suffix("_b")).unwrap_or(&part.name).to_string();
+        map.entry(base).or_default().push(k);
+    }
+    map.into_iter().map(|(base, variants)| PartitionGroup { base, variants }).collect()
+}
+
+/// A module the root solution installed under `/data/adb/modules`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RootModule {
+    /// The folder under `/data/adb/modules`.
+    pub dir: String,
+    pub title: String,
+    pub version: String,
+    pub enabled: bool,
+}
+
+impl App {
+    /// What the by-name table holds, as the runtime read it.
+    pub fn set_partitions(&mut self, read: Result<Vec<Partition>, String>) {
+        self.state.partitions = Some(read);
+        self.refresh();
+    }
+
+    /// Open the partition at this place in the list.
+    pub fn open_partition(&mut self, k: usize) {
+        self.state.partition_open = k;
+        self.state.partition_images = None;
+        self.state.partition_notice = None;
+        self.open(Screen::Partition);
+    }
+
+    /// The images internal storage holds that a partition can be written
+    /// from, or why they could not be read.
+    pub fn set_partition_images(&mut self, read: Result<Vec<(String, u64)>, String>) {
+        self.state.partition_images = Some(read);
+        self.refresh();
+    }
+
+    /// How writing a partition or an image into one ended.
+    pub fn partition_done(&mut self, what: Result<String, String>) {
+        self.state.partition_notice = Some(match what {
+            Ok(done) => done,
+            Err(e) => e,
+        });
+        self.refresh();
+    }
+
+    /// The root solution's modules, as the runtime read them.
+    pub fn set_root_modules(&mut self, read: Result<Vec<RootModule>, String>) {
+        self.state.root_modules = Some(read);
+        self.refresh();
+    }
+}
