+pub fn partitions(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let mut c = long_page(cx);
+    let mut out = Vec::new();
+    let top = t.m.content_top;
+    let y = widgets::section_first(&mut c, t, f, top, l.pick(PARTITIONS_TITLE));
+    let search = widgets::list(&mut c, t, f, y, &[Row::new(l.pick(["搜索分区", "搜尋分割區", "Search partitions"])).trail(Trail::Arrow)]);
+    out.extend(hits(&search.rows, &[Action::OpenPartitionSearch]));
+    let y = search.bottom;
+    let y = match &s.partitions {
+        None => widgets::list(&mut c, t, f, y, &[Row::new(l.pick(["正在读取分区…", "正在讀取分割區…", "Reading the partitions…"])).trail(Trail::None)]).bottom,
+        Some(Err(why)) => {
+            let y = widgets::list(&mut c, t, f, y, &[Row::new(l.pick(["无法读取分区", "無法讀取分割區", "Couldn't read the partitions"])).trail(Trail::None)]).bottom;
+            widgets::footnote(&mut c, t, f, y, why)
+        }
+        Some(Ok(parts)) if parts.is_empty() => {
+            widgets::list(&mut c, t, f, y, &[Row::new(l.pick(["没有可用的分区", "沒有可用的分割區", "No partitions"])).trail(Trail::None)]).bottom
+        }
+        Some(Ok(parts)) => {
+            // A/B copies are one entry, and the copies show on the page it
+            // opens; more entries than one canvas holds are drawn as they
+            // scroll into view, the way the file manager draws a folder.
+            let y = widgets::footnote(&mut c, t, f, y, l.pick([
+                "A/B 分区合成一项，点进去选槽位；再点一个槽位可以把它提取成镜像，或把 /sdcard/Download 里的镜像写进去。",
+                "A/B 分割區合成一項，點進去選槽位；再點一個槽位可以把它提取成映像檔，或把 /sdcard/Download 裡的映像檔寫進去。",
+                "A/B copies share one entry; open it to pick a slot, then extract that partition or write an image from /sdcard/Download into it.",
+            ]));
+            let grouped = groups(parts);
+            let step = t.m.dp(72.0).round();
+            let mut edges = Vec::with_capacity(grouped.len() + 1);
+            let mut at = y.round();
+            edges.push(at);
+            for _ in grouped.iter() {
+                at += step;
+                edges.push(at);
+            }
+            return Frame { rows: Some(Rows { edges, action: Some(Action::OpenPartitionGroup) }), ..Frame::new(t, fit(c, t, y), out, l.pick(PARTITIONS_TITLE), top) };
+        }
+    };
+    Frame::new(t, fit(c, t, y), out, l.pick(PARTITIONS_TITLE), top)
+}
+
+pub fn partition_group(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let mut c = long_page(cx);
+    let mut out = Vec::new();
+    let top = t.m.content_top;
+    let title = l.pick(PARTITIONS_TITLE);
+    let parts = match &s.partitions {
+        Some(Ok(parts)) => parts,
+        _ => {
+            let y = widgets::section_first(&mut c, t, f, top, title);
+            let y = widgets::list(&mut c, t, f, y, &[Row::new(l.pick(["正在读取分区…", "正在讀取分割區…", "Reading the partitions…"])).trail(Trail::None)]).bottom;
+            return Frame::new(t, fit(c, t, y), out, title, top);
+        }
+    };
+    let grouped = groups(parts);
+    let Some(group) = grouped.get(s.partition_group) else {
+        let y = widgets::section_first(&mut c, t, f, top, title);
+        return Frame::new(t, fit(c, t, y), out, title, top);
+    };
+    let y = widgets::section_first(&mut c, t, f, top, &group.base);
+    let names: Vec<String> = group
+        .variants
+        .iter()
+        .map(|&k| {
+            let part = &parts[k];
+            if part.name.ends_with("_a") {
+                l.pick(["槽位 A", "槽位 A", "Slot A"]).to_string()
+            } else if part.name.ends_with("_b") {
+                l.pick(["槽位 B", "槽位 B", "Slot B"]).to_string()
+            } else {
+                l.pick(["唯一", "唯一", "Only"]).to_string()
+            }
+        })
+        .collect();
+    let subs: Vec<String> = group
+        .variants
+        .iter()
+        .map(|&k| {
+            let part = &parts[k];
+            format!("{} · {}", part.name, partition_size(l, part.size))
+        })
+        .collect();
+    let rows: Vec<Row> = names
+        .iter()
+        .zip(&subs)
+        .map(|(name, sub)| Row::new(name).subtitle(sub).trail(Trail::Arrow))
+        .collect();
+    let list = widgets::list(&mut c, t, f, y, &rows);
+    let actions: Vec<Action> = group.variants.iter().map(|&k| Action::OpenPartitionVariant(k)).collect();
+    out.extend(hits(&list.rows, &actions));
+    let y = widgets::footnote(&mut c, t, f, list.bottom, l.pick([
+        "选一个槽位，再决定提取它还是把镜像写进去。",
+        "選一個槽位，再決定提取它還是把映像檔寫進去。",
+        "Pick a slot, then extract it or write an image into it.",
+    ]));
+    Frame::new(t, fit(c, t, y), out, title, top)
+}
+
+pub fn partition(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let mut c = long_page(cx);
+    let mut out = Vec::new();
+    let top = t.m.content_top;
+    let title = l.pick(PARTITIONS_TITLE);
+    let (part, mut y) = match &s.partitions {
+        Some(Ok(parts)) if s.partition_open < parts.len() => (&parts[s.partition_open], top),
+        Some(Err(why)) => {
+            let y = widgets::section_first(&mut c, t, f, top, title);
+            let y = widgets::footnote(&mut c, t, f, y, why);
+            return Frame::new(t, fit(c, t, y), out, title, top);
+        }
+        _ => {
+            let y = widgets::section_first(&mut c, t, f, top, title);
+            let y = widgets::list(&mut c, t, f, y, &[Row::new(l.pick(["正在读取分区…", "正在讀取分割區…", "Reading the partitions…"])).trail(Trail::None)]).bottom;
+            return Frame::new(t, fit(c, t, y), out, title, top);
+        }
+    };
+    let facts = [
+        (l.pick(["名称", "名稱", "Name"]), part.name.clone()),
+        (l.pick(["大小", "大小", "Size"]), partition_size(l, part.size)),
+        (l.pick(["设备", "裝置", "Device"]), part.device.clone()),
+    ];
+    y = widgets::info_card(&mut c, t, f, y, &facts);
+    y = widgets::section(&mut c, t, f, y + t.m.card_gap, l.pick(["操作", "操作", "Actions"]));
+    let rows = [
+        Row::new(l.pick(["提取分区", "提取分割區", "Extract partition"]))
+            .icon(BLUE, Icon::Folder)
+            .subtitle(l.pick(["把整个分区写成 /sdcard/Download/<分区名>.img", "把整個分割區寫成 /sdcard/Download/<分割區名>.img", "Write the whole partition to /sdcard/Download/<name>.img"])),
+        Row::new(l.pick(["刷入镜像", "刷入映像檔", "Flash an image"]))
+            .icon(GREEN, Icon::Install)
+            .subtitle(l.pick(["从 /sdcard/Download 里的镜像写入这个分区", "從 /sdcard/Download 裡的映像檔寫入這個分割區", "Write an image in /sdcard/Download into this partition"])),
+    ];
+    let acts = widgets::list(&mut c, t, f, y, &rows);
+    out.extend(hits(&acts.rows, &[Action::PartitionExtract, Action::PartitionImages]));
+    y = widgets::footnote(&mut c, t, f, acts.bottom, l.pick([
+        "提取不改变分区；刷入会覆盖这个分区里的原有内容，且不可撤销。",
+        "提取不改變分割區；刷入會覆寫這個分割區裡的原有內容，且不可復原。",
+        "Extracting changes nothing; flashing covers what the partition holds, and cannot be undone.",
+    ]));
+    match &s.partition_images {
+        None => {}
+        Some(Err(why)) => {
+            y = widgets::footnote(&mut c, t, f, y + t.m.card_gap, why);
+        }
+        Some(Ok(images)) if images.is_empty() => {
+            y = widgets::footnote(&mut c, t, f, y + t.m.card_gap, l.pick([
+                "/sdcard/Download 里没有镜像文件。",
+                "/sdcard/Download 裡沒有映像檔。",
+                "There is no image in /sdcard/Download.",
+            ]));
+        }
+        Some(Ok(images)) => {
+            y = widgets::section(&mut c, t, f, y + t.m.card_gap, l.pick(["可刷入的镜像", "可刷入的映像檔", "Images to flash"]));
+            let sizes: Vec<String> = images.iter().map(|(_, size)| partition_size(l, *size)).collect();
+            let rows: Vec<Row> = images.iter().zip(&sizes).map(|((name, _), size)| Row::new(name).subtitle(size).trail(Trail::Arrow)).collect();
+            let list = widgets::list(&mut c, t, f, y, &rows);
+            let actions: Vec<Action> = (0..images.len()).map(Action::PartitionFlash).collect();
+            out.extend(hits(&list.rows, &actions));
+            y = widgets::footnote(&mut c, t, f, list.bottom, l.pick([
+                "点一个镜像就会把它写进这个分区；写之前先确认镜像对应的是这个分区。",
+                "點一個映像檔就會把它寫進這個分割區；寫之前先確認映像檔對應的是這個分割區。",
+                "Tap an image to write it into this partition; make sure the image is meant for it first.",
+            ]));
+        }
+    }
+    if let Some(note) = &s.partition_notice {
+        y = widgets::footnote(&mut c, t, f, y + t.m.card_gap, note);
+    }
+    Frame::new(t, fit(c, t, y), out, title, top)
+}
+
+pub fn root_modules(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let mut c = long_page(cx);
+    let mut out = Vec::new();
+    let top = t.m.content_top;
+    let title = l.pick(["Root 模块", "Root 模組", "Root modules"]);
+    let y = widgets::section_first(&mut c, t, f, top, title);
+    let y = if !s.data.storage_open() {
+        widgets::footnote(&mut c, t, f, y, l.pick([
+            "需要先解开 data 分区，才能看到 /data/adb/modules。",
+            "需要先解開 data 分割區，才能看到 /data/adb/modules。",
+            "The data partition has to be open before /data/adb/modules can be read.",
+        ]))
+    } else {
+        match &s.root_modules {
+            None => widgets::list(&mut c, t, f, y, &[Row::new(l.pick(["正在读取模块…", "正在讀取模組…", "Reading the modules…"])).trail(Trail::None)]).bottom,
+            Some(Err(why)) => {
+                let y = widgets::list(&mut c, t, f, y, &[Row::new(l.pick(["无法读取模块", "無法讀取模組", "Couldn't read the modules"])).trail(Trail::None)]).bottom;
+                widgets::footnote(&mut c, t, f, y, why)
+            }
+            Some(Ok(modules)) if modules.is_empty() => {
+                let y = widgets::list(&mut c, t, f, y, &[Row::new(l.pick(["没有找到 Root 模块", "沒有找到 Root 模組", "No root modules"])).trail(Trail::None)]).bottom;
+                widgets::footnote(&mut c, t, f, y, l.pick([
+                    "这里读取的是 /data/adb/modules（KernelSU / Magisk 的模块目录）。装好 root 并重启后再来看。",
+                    "這裡讀取的是 /data/adb/modules（KernelSU / Magisk 的模組目錄）。裝好 root 並重新啟動後再來看。",
+                    "This reads /data/adb/modules, the KernelSU / Magisk module folder. Come back after root is installed and the phone restarted.",
+                ]))
+            }
+            Some(Ok(modules)) => {
+                let rows: Vec<Row> = modules
+                    .iter()
+                    .map(|m| Row::new(&m.title).subtitle(&m.version).trail(Trail::Switch(m.enabled)))
+                    .collect();
+                let list = widgets::list(&mut c, t, f, y, &rows);
+                out.extend(list.rows.iter().enumerate().map(|(k, &rect)| Hit { rect, action: Action::ToggleRootModule(k) }));
+                widgets::footnote(&mut c, t, f, list.bottom, l.pick([
+                    "开关会写入或删除模块目录下的 disable 文件，重启后生效。",
+                    "開關會寫入或刪除模組目錄下的 disable 檔案，重新啟動後生效。",
+                    "Switching writes or removes the disable file in the module's folder; it takes effect after a restart.",
+                ]))
+            }
+        }
+    };
+    Frame::new(t, fit(c, t, y), out, title, top)
+}
