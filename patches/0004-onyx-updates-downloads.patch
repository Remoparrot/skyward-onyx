+/// The name a URL's last path segment gives a file, made safe for a
+/// filesystem; `download.bin` where it names none.
+pub fn name_of(url: &str) -> String {
+    let path = url.split(['?', '#']).next().unwrap_or(url);
+    let path = path.split_once("://").map_or(path, |(_, rest)| rest);
+    let last = path.rsplit('/').next().unwrap_or("");
+    let mut name = String::new();
+    let bytes = last.as_bytes();
+    let mut i = 0;
+    while i < bytes.len() {
+        let c = bytes[i];
+        if c == b'%' && i + 2 < bytes.len() {
+            if let Ok(v) = u8::from_str_radix(&last[i + 1..i + 3], 16) {
+                if v.is_ascii_alphanumeric() || matches!(v, b'.' | b'-' | b'_' | b'(' | b')' | b' ') {
+                    name.push(v as char);
+                } else {
+                    name.push('_');
+                }
+                i += 3;
+                continue;
+            }
+        }
+        let ch = last[i..].chars().next().unwrap_or('_');
+        if ch.is_ascii_alphanumeric() || matches!(ch, '.' | '-' | '_' | '(' | ')' | ' ') {
+            name.push(ch);
+        } else {
+            name.push('_');
+        }
+        i += ch.len_utf8();
     }
+    let name = name.trim().trim_end_matches('.').trim_start_matches('.');
+    if name.is_empty() || name == ".." {
+        "download.bin".into()
+    } else {
+        name.chars().take(120).collect()
+    }
+}
