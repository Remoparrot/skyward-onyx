+/// The whole package over one connection, from its start.
+fn stream(agent: &ureq::Agent, url: &str, file: &mut File, total: u64, stop: &AtomicBool, progress: &mut dyn FnMut(Progress)) -> Result<()> {
+    let mut response = agent.get(url).call().context("start the download")?;
+    match response.status().as_u16() {
+        200 => {}
+        status => bail!(Refused(status)),
+    }
+    let mut body = response.body_mut().with_config().limit(u64::MAX).reader();
+    let mut buf = vec![0u8; CHUNK];
+    let mut done = 0u64;
+    progress(Progress::Downloading { done, total });
+    while done < total {
+        if stop.load(Ordering::Relaxed) {
+            bail!(crate::Stopped);
+        }
+        let n = body.read(&mut buf).context("download the package")?;
+        if n == 0 {
+            bail!("the server stopped sending at {done} of {total} bytes");
+        }
+        let n = n.min((total - done) as usize);
+        file.write_all(&buf[..n]).context("write the package")?;
+        done += n as u64;
+        progress(Progress::Downloading { done, total });
+    }
+    Ok(())
+}
