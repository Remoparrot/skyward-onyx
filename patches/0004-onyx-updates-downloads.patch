+/// The runs a package `total` bytes long is fetched in, from its start.
+fn runs(total: u64) -> Vec<(u64, u64)> {
+    let count = ((total + SEGMENT - 1) / SEGMENT).clamp(1, MAX_CONNECTIONS as u64) as usize;
+    (0..count)
+        .map(|i| {
+            let start = total * i as u64 / count as u64;
+            let end = total * (i as u64 + 1) / count as u64 - 1;
+            (start, end)
+        })
+        .collect()
+}
