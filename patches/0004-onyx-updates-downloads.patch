+/// Save whatever `url` answers into `path`, with no digest to check it
+/// against, telling how far it has come. The part is named once the whole
+/// answer is there.
+pub fn save(agent: &ureq::Agent, url: &str, path: &Path, stop: &AtomicBool, paused: &AtomicBool, progress: &mut dyn FnMut(Progress)) -> Result<()> {
+    let mut response = agent.get(url).call().context("start the download")?;
+    let status = response.status().as_u16();
+    if !(200..300).contains(&status) {
+        bail!(Refused(status));
+    }
+    let total = content_length(response.headers()).unwrap_or(0);
+    let part = partial(path);
+    let dir = path.parent().context("a download's path is in a folder")?;
+    fs::create_dir_all(dir).with_context(|| format!("make {}", dir.display()))?;
+    let mut file = File::create(&part).with_context(|| format!("open {}", part.display()))?;
+    let mut body = response.body_mut().with_config().limit(u64::MAX).reader();
+    let mut buf = vec![0u8; CHUNK];
+    let mut done = 0u64;
+    progress(Progress::Downloading { done, total });
+    loop {
+        while paused.load(Ordering::Relaxed) {
+            if stop.load(Ordering::Relaxed) {
+                bail!(crate::Stopped);
+            }
+            std::thread::sleep(std::time::Duration::from_millis(100));
+        }
+        if stop.load(Ordering::Relaxed) {
+            bail!(crate::Stopped);
+        }
+        let n = body.read(&mut buf).context("download the file")?;
+        if n == 0 {
+            break;
+        }
+        file.write_all(&buf[..n]).with_context(|| format!("write {}", part.display()))?;
+        done += n as u64;
+        progress(Progress::Downloading { done, total });
+    }
+    file.sync_all().with_context(|| format!("write {} through", part.display()))?;
+    drop(file);
     fs::rename(&part, path).with_context(|| format!("name {} {}", part.display(), path.display()))
 }
 
