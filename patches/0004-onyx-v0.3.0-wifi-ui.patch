+    let m = &t.m;
+    let pad = (size * 0.06).max(m.dp(10.0));
+    c.fill_round_rect(x - pad, y - pad, size + pad * 2.0, size + pad * 2.0, m.dp(18.0), Rgba::rgb(255, 255, 255));
+    let n = code.size() as f32;
+    let cell = size / n;
+    for row in 0..code.size() {
+        for col in 0..code.size() {
+            if code.get_module(col, row) {
+                c.fill_rect(x + col as f32 * cell, y + row as f32 * cell, cell.ceil(), cell.ceil(), Rgba::rgb(0, 0, 0));
+            }
+        }
+    }
+    true
