+        &mut c,
+        t,
+        f,
+        m.content_top,
+        l.pick([
+            "设置 recovery 锁屏密码后，每次进入恢复模式都需先输入密码，才能打开 data 分区。密码为 4 到 8 位数字，只保存加密后的结果。",
+            "設定復原模式鎖屏密碼後，每次進入復原模式都需先輸入密碼，才能開啟 data 分割區。密碼為 4 到 8 位數字，只儲存加密後的結果。",
+            "With a recovery lock, the data partition opens only after its code is entered at every start. The code is 4 to 8 digits, and only a salted hash of it is kept.",
+        ]),
+    );
+    if s.lock.is_some() {
+        let off = widgets::list(&mut c, t, f, y + t.m.card_gap, &[Row::new(l.pick(["关闭锁屏", "關閉鎖屏", "Turn the lock off"])).icon(RED, Icon::Lock)]);
+        out.extend(hits(&off.rows, &[Action::LockOff]));
+        y = off.bottom;
+    }
+    c.text_center(
+        &f.body,
+        l.pick(["输入新密码", "輸入新密碼", "Enter a new code"]),
+        m.w as f32 / 2.0,
+        y + t.m.dp(40.0),
+        m.sub_px,
+        t.pal.subtitle,
+    );
+    let top = m.h as f32 - widgets::keypad_height(t);
+    widgets::code_dots(&mut c, t, m.w as f32 / 2.0, top - m.dp(92.0), s.code.chars().count());
+    let caps = widgets::keypad(&mut c, t, f, l, top, s.key_held(), l.pick(["保存", "儲存", "Save"]));
+    out.extend(caps.into_iter().map(|(rect, cap)| Hit { rect, action: Action::Type(cap) }));
+    Frame::new(t, c, out, l.pick(["锁屏密码", "鎖屏密碼", "Lock code"]), m.content_top)
+}
