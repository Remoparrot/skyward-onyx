+/// The recovery's lock: the code is never kept, only a salt and the
+/// SHA-256 of the salt and the code.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Lock {
+    pub salt: String,
+    pub hash: String,
+}
+
+impl Default for Lock {
+    fn default() -> Self {
+        Lock { salt: String::new(), hash: String::new() }
+    }
+}
+
+impl Lock {
+    /// A lock for `code`, with a salt made from the clock. A recovery has no
+    /// random source worth the name, and the salt only keeps one recovery's
+    /// hash from telling another's.
+    pub fn set(code: &str) -> Lock {
+        let nanos = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_nanos()).unwrap_or(0);
+        let salt = format!("{:x}{:x}", nanos, std::process::id());
+        Lock { hash: Lock::hashed(&salt, code), salt }
+    }
+
+    fn hashed(salt: &str, code: &str) -> String {
+        let mut h = Sha256::new();
+        h.update(salt.as_bytes());
+        h.update(code.as_bytes());
+        h.finalize().iter().map(|b| format!("{b:02x}")).collect()
+    }
+
+    pub fn matches(&self, code: &str) -> bool {
+        !self.hash.is_empty() && Lock::hashed(&self.salt, code) == self.hash
+    }
+}
