+/// The recovery's own lock: with a code set, the keypad that types it; with
+/// none, the swipe the phone's own lock screen shows.
+pub fn lock(cx: &Ctx) -> Frame {
+    if cx.state.lock.is_none() {
+        return lock_swipe(cx);
+    }
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = page(cx);
+    let x = m.w as f32 / 2.0;
+    let now = jiff::Timestamp::now().as_second();
+    c.text_center(&f.title, &fmt::clock(now, s.time_zone), x, m.dp(206.0), m.dp(86.0), t.pal.text);
+    c.text_center(&f.body, &fmt::date(l, now, s.time_zone), x, m.dp(266.0), m.sub_px, t.pal.subtitle);
+    c.text_center(&f.heading, l.pick(["Skyward 恢复模式", "Skyward 復原模式", "Skyward recovery"]), x, m.dp(330.0), m.dp(20.0), t.pal.accent);
+    let note = l.pick(["输入 recovery 锁屏密码", "輸入復原模式鎖屏密碼", "Enter the recovery lock"]);
+    c.text_center(&f.body, note, x, m.dp(376.0), m.sub_px, t.pal.subtitle);
+    let top = m.h as f32 - widgets::keypad_height(t);
+    widgets::code_dots(&mut c, t, x, top - m.dp(92.0), s.code.chars().count());
+    let mut out = Vec::new();
+    let caps = widgets::keypad(&mut c, t, f, l, top, s.key_held(), l.pick(["解锁", "解鎖", "Unlock"]));
+    out.extend(caps.into_iter().map(|(rect, cap)| Hit { rect, action: Action::Type(cap) }));
+    Frame { header: false, back: false, ..Frame::new(t, c, out, "", 0.0) }
+}
+
+/// The lock screen without a recovery code: the date, the clock, the
+/// battery, and a pill slid to open the decrypt page.
+fn lock_swipe(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = page(cx);
+    let (w, h) = (m.w as f32, m.h as f32);
+    c.fill_rect(0.0, 0.0, w, h, Rgba::rgb(0, 0, 0));
+    let x = w / 2.0;
+    let now = jiff::Timestamp::now().as_second();
+    let white = Rgba::rgb(255, 255, 255);
+    c.text_center(&f.body, &fmt::date(l, now, s.time_zone), x, m.dp(172.0), m.sub_px * 1.15, white);
+    c.text_center(&f.title, &fmt::clock(now, s.time_zone), x, m.dp(232.0), m.dp(84.0), white);
+    if let Some(battery) = &cx.info.battery {
+        c.text_center(&f.body, &format!("{}%", battery.level), x, m.dp(320.0), m.sub_px, white);
+    }
+    let (label, _) = confirm_label(Confirm::UnlockScreen, s);
+    let track = widgets::confirm(&mut c, t, f, h - m.dp(112.0), label, false, s.confirm);
+    let out = vec![Hit { rect: track, action: Action::Confirm(Confirm::UnlockScreen) }];
+    Frame { header: false, back: false, ..Frame::new(t, c, out, "", 0.0) }
+}
+
+/// Setting, changing or taking away the recovery's lock. The code typed is
