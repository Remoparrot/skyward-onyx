+/// A web page read as text: the URL, its title, and what the tags leave.
+/// There is no JavaScript or CSS engine here, and no pictures: this is a
+/// reader for pages whose words are in the HTML.
+pub fn web(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = long_page(cx);
+    let out = Vec::new();
+    let top = m.content_top;
+    let mut y = widgets::section_first(&mut c, t, f, top, l.pick(["网页", "網頁", "Web"]));
+    y = widgets::footnote(&mut c, t, f, y, &s.web_url);
+    let mut title = l.pick(["正在读取网页", "正在讀取網頁", "Reading the page"]).to_string();
+    let mut text = String::new();
+    match &s.web_page {
+        Some(Ok(page)) => {
+            title = if page.title.trim().is_empty() { s.web_url.clone() } else { page.title.clone() };
+            text = page.text.clone();
+        }
+        Some(Err(why)) => {
+            title = l.pick(["未能打开网页", "無法開啟網頁", "Couldn't open the page"]).to_string();
+            text = why.clone();
+        }
+        None => {}
+    }
+    y = widgets::section(&mut c, t, f, y, &title);
+    if !text.trim().is_empty() {
+        y = widgets::paragraph(&mut c, t, f, y, &text);
+    } else if s.web_page.is_some() {
+        y = widgets::footnote(&mut c, t, f, y, l.pick([
+            "页面没有可显示的文本；它可能要靠 JavaScript 才能显示。",
+            "頁面沒有可顯示的文字；它可能要靠 JavaScript 才能顯示。",
+            "The page leaves no text to read; it may need JavaScript to show.",
+        ]));
+    }
+    let note = l.pick([
+        "文本模式：不运行 JavaScript 和 CSS，不显示图片。",
+        "文字模式：不執行 JavaScript 和 CSS，不顯示圖片。",
+        "Text mode: no JavaScript, CSS or pictures.",
+    ]);
+    y = widgets::footnote(&mut c, t, f, y, note);
+    Frame::new(t, fit(c, t, y), out, l.pick(["网页", "網頁", "Web"]), top)
+}
