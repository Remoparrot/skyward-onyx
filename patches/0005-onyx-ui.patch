+/// fills the field too.
+pub fn download(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let (w, x) = (m.w as f32, m.w as f32 / 2.0);
