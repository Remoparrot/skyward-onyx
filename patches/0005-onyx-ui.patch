+/// Turning off the booted slot's dm-verity and verification, with a swipe:
+/// what it does and what it risks.
+pub fn avb(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let mut c = page(cx);
+    let top = t.m.content_top;
+    let what = l.pick([
+        "关闭当前槽位 vbmeta 中的 dm-verity 与启动校验。关闭后，系统启动时不再校验分区；已解锁的 bootloader 才会采用这一设置。",
+        "關閉目前槽位 vbmeta 中的 dm-verity 與啟動驗證。關閉後，系統啟動時不再驗證分割區；已解鎖的 bootloader 才會採用這項設定。",
+        "Turns off dm-verity and verification in the booted slot's vbmeta. The system then starts without checking its partitions; only an unlocked bootloader honours it.",
+    ]);
+    let mut y = widgets::paragraph(&mut c, t, f, top, what);
+    let warning = l.pick([
+        "此操作会改写 vbmeta。若系统或 bootloader 依赖这些标志，手机可能无法启动；请确认已有可回滚的镜像。",
+        "此操作會改寫 vbmeta。若系統或 bootloader 依賴這些旗標，手機可能無法啟動；請確認已有可回滾的映像檔。",
+        "This rewrites vbmeta. If the system or bootloader relies on these flags, the phone may not start; make sure a working image can be flashed back.",
+    ]);
+    y = widgets::footnote(&mut c, t, f, y + t.m.card_gap, warning);
+    let (label, danger) = confirm_label(Confirm::DisableAvb, s);
+    let track = widgets::confirm(&mut c, t, f, y + t.m.dp(24.0), label, danger, s.confirm);
+    let out = vec![Hit { rect: track, action: Action::Confirm(Confirm::DisableAvb) }];
+    Frame::new(t, c, out, l.pick(["禁用 AVB 2.0", "停用 AVB 2.0", "Disable AVB 2.0"]), top)
+}
