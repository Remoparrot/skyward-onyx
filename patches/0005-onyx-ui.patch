+    let mut c = sheet(cx, t.m.h, Rgba { r: 0, g: 0, b: 0, a: 0 });
+    match cx.backdrop.filter(|page| page.w > 0 && page.h > 0) {
+        Some(page) => c.blit_scaled(page, w, h),
+        None => c.fill_rect(0.0, 0.0, w, h, t.pal.bg),
+    }
+    // Only a veil, not a coat: the page behind is to be seen, blurred and
+    // dimmed just enough for the clock and the words to read over it.
+    let veil = match t.dark {
+        true => Rgba::rgb(0, 0, 0).with_alpha(88),
+        false => Rgba::rgb(250, 250, 252).with_alpha(56),
+    };
+    c.fill_rect_over(0.0, 0.0, w, h, veil);
+    c
+}
