+/// The recovery's own lock: with a code set, the keypad that types it; with
+/// none, the swipe the phone's own lock screen shows.
+pub fn lock(cx: &Ctx) -> Frame {
+    if cx.state.lock.is_none() {
+        return lock_swipe(cx);
+    }
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = lock_sheet(cx);
+    let x = m.w as f32 / 2.0;
+    let now = jiff::Timestamp::now().as_second();
+    c.text_center(&f.title, &fmt::clock(now, s.time_zone), x, m.dp(206.0), m.dp(86.0), t.pal.text);
+    c.text_center(&f.body, &fmt::date(l, now, s.time_zone), x, m.dp(266.0), m.sub_px, t.pal.subtitle);
+    c.text_center(&f.heading, l.pick(["Skyward 恢复模式", "Skyward 復原模式", "Skyward recovery"]), x, m.dp(330.0), m.dp(20.0), t.pal.accent);
+    let note = l.pick(["输入 recovery 锁屏密码", "輸入復原模式鎖屏密碼", "Enter the recovery lock"]);
+    c.text_center(&f.body, note, x, m.dp(376.0), m.sub_px, t.pal.subtitle);
+    let top = m.h as f32 - widgets::keypad_height(t);
+    widgets::code_dots(&mut c, t, x, top - m.dp(92.0), s.code.chars().count());
+    let mut out = Vec::new();
+    let caps = widgets::keypad(&mut c, t, f, l, top, s.key_held(), l.pick(["解锁", "解鎖", "Unlock"]));
+    out.extend(caps.into_iter().map(|(rect, cap)| Hit { rect, action: Action::Type(cap) }));
+    Frame { header: false, back: false, ..Frame::new(t, c, out, "", 0.0) }
+}
+
+/// The lock screen without a recovery code: the date, the clock, the
+/// battery, and a frosted pill slid to open the decrypt page.
+fn lock_swipe(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let (w, h) = (m.w as f32, m.h as f32);
+    let mut c = lock_sheet(cx);
+    let x = w / 2.0;
+    let now = jiff::Timestamp::now().as_second();
+    c.text_center(&f.body, &fmt::date(l, now, s.time_zone), x, m.dp(172.0), m.sub_px * 1.15, t.pal.text);
+    c.text_center(&f.title, &fmt::clock(now, s.time_zone), x, m.dp(232.0), m.dp(84.0), t.pal.text);
+    if let Some(battery) = &cx.info.battery {
+        c.text_center(&f.body, &format!("{}%", battery.level), x, m.dp(320.0), m.sub_px, t.pal.subtitle);
+    }
+    let (label, _) = confirm_label(Confirm::UnlockScreen, s);
+    let track = widgets::lock_confirm(&mut c, t, f, h - m.dp(112.0), label, s.confirm);
+    let out = vec![Hit { rect: track, action: Action::Confirm(Confirm::UnlockScreen) }];
+    Frame { header: false, back: false, ..Frame::new(t, c, out, "", 0.0) }
+}
+
+/// Setting, changing or taking away the recovery's lock. The code typed is
+/// kept as a salted hash, never as it was typed.
+pub fn lock_set(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = page(cx);
+    let mut out = Vec::new();
+    let mut y = widgets::paragraph(
+        &mut c,
+        t,
+        f,
+        m.content_top,
+        l.pick([
+            "设置后，data 分区解开、屏幕熄灭再点亮时，需先输入密码才能继续使用恢复模式。data 解密前不会锁屏。密码为 4 到 8 位数字，只保存加密后的结果。",
+            "設定後，data 分割區解開、螢幕關閉再點亮時，需先輸入密碼才能繼續使用復原模式。data 解密前不會鎖屏。密碼為 4 到 8 位數字，只儲存加密後的結果。",
+            "With a recovery lock, lighting the screen again once the data partition is open asks for the code. The lock is never asked before data is decrypted. The code is 4 to 8 digits, and only a salted hash of it is kept.",
+        ]),
+    );
+    if s.lock.is_some() {
+        let off = widgets::list(&mut c, t, f, y + t.m.card_gap, &[Row::new(l.pick(["关闭锁屏", "關閉鎖屏", "Turn the lock off"])).icon(RED, Icon::Lock)]);
+        out.extend(hits(&off.rows, &[Action::LockOff]));
+        y = off.bottom;
+    }
+    c.text_center(
+        &f.body,
+        l.pick(["输入新密码", "輸入新密碼", "Enter a new code"]),
+        m.w as f32 / 2.0,
+        y + t.m.dp(40.0),
+        m.sub_px,
+        t.pal.subtitle,
+    );
+    let top = m.h as f32 - widgets::keypad_height(t);
+    widgets::code_dots(&mut c, t, m.w as f32 / 2.0, top - m.dp(92.0), s.code.chars().count());
+    let caps = widgets::keypad(&mut c, t, f, l, top, s.key_held(), l.pick(["保存", "儲存", "Save"]));
+    out.extend(caps.into_iter().map(|(rect, cap)| Hit { rect, action: Action::Type(cap) }));
+    Frame::new(t, c, out, l.pick(["锁屏密码", "鎖屏密碼", "Lock code"]), m.content_top)
+}
