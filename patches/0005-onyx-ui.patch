+/// A file downloading from a URL: the messages the thread sends, the switch
+/// that stops it, and the thread.
+enum UrlEvent {
+    Progress(download::Progress),
+    Ended(Result<String, String>),
+}
+
+struct UrlDownloader {
+    events: mpsc::Receiver<UrlEvent>,
+    stop: Arc<AtomicBool>,
+    paused: Arc<AtomicBool>,
+    thread: Option<std::thread::JoinHandle<()>>,
+}
+
+impl UrlDownloader {
+    fn start(url: String, name: String, servers: Servers) -> Result<UrlDownloader> {
+        let (tx, events) = mpsc::channel();
+        let stop = Arc::new(AtomicBool::new(false));
+        let paused = Arc::new(AtomicBool::new(false));
+        let (stopping, holding) = (stop.clone(), paused.clone());
+        let thread = std::thread::Builder::new().name("url-download".into()).spawn(move || {
+            let agent = skyward_net::http::agent(servers);
+            let path = Path::new(skyward_crypto::data::SDCARD).join("Download").join(&name);
+            let mut tell = |progress| {
+                let _ = tx.send(UrlEvent::Progress(progress));
+            };
+            let ended = download::save(&agent, &url, &path, &stopping, &holding, &mut tell)
+                .map(|()| path.display().to_string())
+                .map_err(|e| format!("{e:#}"));
+            let _ = tx.send(UrlEvent::Ended(ended));
+        })?;
+        Ok(UrlDownloader { events, stop, paused, thread: Some(thread) })
+    }
+
+    fn stop(&self) {
+        self.stop.store(true, Ordering::Relaxed);
+    }
+
+    fn pause(&self) {
+        self.paused.store(true, Ordering::Relaxed);
+    }
+
+    fn resume(&self) {
+        self.paused.store(false, Ordering::Relaxed);
+    }
+}
+
+impl Drop for UrlDownloader {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+/// The page the download page's QR code opens: another phone enters a URL,
+/// and the page sends it back to the recovery.
+struct UrlForm {
+    addr: String,
+    requests: mpsc::Receiver<String>,
+}
+
+impl UrlForm {
+    fn start() -> Result<UrlForm> {
+        let mut bound = None;
+        for port in 8080..8090 {
+            if let Ok(listener) = TcpListener::bind(("0.0.0.0", port)) {
+                bound = Some((listener, port));
+                break;
+            }
+        }
+        let (listener, port) = bound.context("no port from 8080 to 8089 could be bound")?;
+        listener.set_nonblocking(true).context("make the QR page's listener non-blocking")?;
+        let ip = local_ip().unwrap_or_else(|| "127.0.0.1".into());
+        let addr = format!("http://{ip}:{port}/");
+        let (tx, requests) = mpsc::channel();
+        std::thread::Builder::new().name("url-form".into()).spawn(move || serve_url_form(listener, tx))?;
+        Ok(UrlForm { addr, requests })
+    }
+}
+
+/// The address another phone can reach this recovery at, as the route to
+/// the outside world names it.
+fn local_ip() -> Option<String> {
+    let socket = UdpSocket::bind("0.0.0.0:0").ok()?;
+    socket.connect("8.8.8.8:80").ok()?;
+    Some(socket.local_addr().ok()?.ip().to_string())
+}
+
+fn serve_url_form(listener: TcpListener, requests: mpsc::Sender<String>) {
+    loop {
+        match listener.accept() {
+            Ok((mut stream, _)) => {
+                let _ = answer_url_form(&mut stream, &requests);
+            }
+            Err(ref e) if e.kind() == std::io::ErrorKind::WouldBlock => std::thread::sleep(Duration::from_millis(100)),
+            Err(_) => std::thread::sleep(Duration::from_millis(200)),
+        }
+    }
+}
+
+fn answer_url_form(stream: &mut std::net::TcpStream, requests: &mpsc::Sender<String>) -> Result<()> {
+    stream.set_read_timeout(Some(Duration::from_secs(2)))?;
+    stream.set_write_timeout(Some(Duration::from_secs(2)))?;
+    let mut buf = vec![0u8; 8192];
+    let n = stream.read(&mut buf)?;
+    let request = String::from_utf8_lossy(&buf[..n]);
+    let path = request.lines().next().and_then(|line| line.split_whitespace().nth(1)).unwrap_or("/");
+    if let Some(query) = path.strip_prefix("/send?") {
+        let url = query.split('&').find_map(|pair| pair.strip_prefix("url=")).map(url_query_decode).unwrap_or_default();
+        if !url.is_empty() {
+            let _ = requests.send(url);
+        }
+        let body = "<!doctype html><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>Skyward</title><body style=\"background:#111;color:#eee;font:18px system-ui;padding:2em\"><h2>已发回手机</h2><p>回到 recovery 的下载页查看。</p>";
+        write_http(stream, "200 OK", body)?;
+        return Ok(());
+    }
+    if path == "/" || path.starts_with("/?") {
+        let body = "<!doctype html><html><head><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>Skyward Download</title></head><body style=\"background:#111;color:#eee;font:18px system-ui;padding:2em;max-width:680px;margin:auto\"><h1>发一个下载链接</h1><p>在下面输入完整网址，发回 recovery 的下载页。</p><form action=\"/send\" method=\"get\"><input name=\"url\" type=\"url\" required placeholder=\"https://example.com/rom.zip\" style=\"width:100%;box-sizing:border-box;font:18px system-ui;padding:.8em;border:1px solid #555;border-radius:12px;background:#222;color:#eee\"><button style=\"margin-top:1em;width:100%;font:18px system-ui;padding:.9em;border:0;border-radius:12px;background:#4d8dff;color:#fff\">发回手机</button></form><p style=\"color:#aaa\">服务只在 recovery 运行时可用。</p></body></html>";
+        write_http(stream, "200 OK", body)?;
+        return Ok(());
+    }
+    write_http(stream, "404 Not Found", "not found")?;
+    Ok(())
+}
+
+fn write_http(stream: &mut std::net::TcpStream, status: &str, body: &str) -> Result<()> {
+    write!(
+        stream,
+        "HTTP/1.1 {status}\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+        body.len()
+    )?;
+    stream.flush()?;
+    Ok(())
+}
+
+fn url_query_decode(text: &str) -> String {
+    let bytes = text.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'+' => out.push(b' '),
+            b'%' if i + 2 < bytes.len() => {
+                if let Ok(v) = u8::from_str_radix(&text[i + 1..i + 3], 16) {
+                    out.push(v);
+                    i += 3;
+                    continue;
+                }
+                out.push(b'%');
+            }
+            b => out.push(b),
+        }
+        i += 1;
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+/// A web page being read as text: the thread's answer, once.
+struct WebFetcher {
+    events: mpsc::Receiver<Result<WebPage, String>>,
+    thread: Option<std::thread::JoinHandle<()>>,
+}
+
+impl WebFetcher {
+    fn start(url: String, servers: Servers) -> Result<WebFetcher> {
+        let (tx, events) = mpsc::channel();
+        let thread = std::thread::Builder::new().name("web".into()).spawn(move || {
+            let agent = skyward_net::http::agent(servers);
+            let page = fetch_web(&agent, &url);
+            let _ = tx.send(page);
+        })?;
+        Ok(WebFetcher { events, thread: Some(thread) })
+    }
+}
+
+impl Drop for WebFetcher {
+    fn drop(&mut self) {
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+fn fetch_web(agent: &ureq::Agent, url: &str) -> Result<WebPage, String> {
+    let mut response = agent.get(url).call().map_err(|e| format!("{e:#}"))?;
+    let status = response.status().as_u16();
+    if !(200..400).contains(&status) {
+        return Err(format!("the server answered {status}"));
+    }
+    let mut bytes = Vec::new();
+    response
+        .body_mut()
+        .with_config()
+        .limit(4 << 20)
+        .reader()
+        .take(4 << 20)
+        .read_to_end(&mut bytes)
+        .map_err(|e| format!("read the page: {e}"))?;
+    let html = String::from_utf8_lossy(&bytes).into_owned();
+    let title = html_title(&html);
+    let text = html_text(&html);
+    Ok(WebPage { url: url.to_string(), title, text })
+}
+
+fn html_title(html: &str) -> String {
+    let lower = html.to_ascii_lowercase();
+    let Some(at) = lower.find("<title") else { return String::new() };
+    let Some(open) = lower[at..].find('>') else { return String::new() };
+    let start = at + open + 1;
+    let Some(end) = lower[start..].find("</title>") else { return String::new() };
+    decode_entities(html[start..start + end].trim())
+}
+
+fn html_text(html: &str) -> String {
+    let mut out = String::new();
+    let bytes = html.as_bytes();
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b'<' {
+            let Some(close) = html[i..].find('>') else { break };
+            let tag = html[i + 1..i + close].trim();
+            let name = tag.split_whitespace().next().unwrap_or("").trim_start_matches('/').to_ascii_lowercase();
+            i += close + 1;
+            if matches!(name.as_str(), "script" | "style" | "noscript") && !tag.starts_with('/') {
+                let end = format!("</{name}>");
+                if let Some(at) = html[i..].to_ascii_lowercase().find(&end) {
+                    i += at + end.len();
+                }
+                continue;
+            }
+            if matches!(
+                name.as_str(),
+                "br" | "p" | "div" | "li" | "tr" | "td" | "th" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "section" | "article" | "header" | "footer" | "blockquote" | "pre" | "hr" | "table" | "ul" | "ol"
+            ) {
+                out.push('\n');
+            }
+            continue;
+        }
+        let ch = html[i..].chars().next().unwrap_or(' ');
+        out.push(ch);
+        i += ch.len_utf8();
+    }
+    let decoded = decode_entities(&out);
+    let mut lines: Vec<String> = Vec::new();
+    for line in decoded.lines() {
+        let clean = line.split_whitespace().collect::<Vec<_>>().join(" ");
+        if clean.is_empty() {
+            if lines.last().is_some_and(|l| !l.is_empty()) {
+                lines.push(String::new());
+            }
+        } else {
+            lines.push(clean);
+        }
+    }
+    let mut text = lines.join("\n");
+    text.truncate(40000);
+    text
+}
+
+fn decode_entities(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut rest = text;
+    while let Some(at) = rest.find('&') {
+        out.push_str(&rest[..at]);
+        rest = &rest[at..];
+        let Some(end) = rest.find(';') else {
+            out.push_str(rest);
+            return out;
+        };
+        let entity = &rest[1..end];
+        let decoded = match entity {
+            "amp" => Some('&'),
+            "lt" => Some('<'),
+            "gt" => Some('>'),
+            "quot" => Some('"'),
+            "apos" => Some('\''),
+            "nbsp" => Some(' '),
+            _ if entity.starts_with("#x") || entity.starts_with("#X") => u32::from_str_radix(&entity[2..], 16).ok().and_then(char::from_u32),
+            _ if entity.starts_with('#') => entity[1..].parse().ok().and_then(char::from_u32),
+            _ => None,
+        };
+        match decoded {
+            Some(ch) => out.push(ch),
+            None => out.push_str(&rest[..=end]),
+        }
+        rest = &rest[end + 1..];
+    }
+    out.push_str(rest);
+    out
+}
