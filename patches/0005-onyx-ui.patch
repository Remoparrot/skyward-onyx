+/// `c` with every pixel the mean of the `reach` pixels either side of it,
+/// three times over, which is close to a Gaussian of that spread. The
+/// small copy the lock screen keeps is softened this way before it is
+/// stretched, so that the blur is smooth rather than the coarse mosaic
+/// of a picture kept too small.
+fn soften(c: &mut Canvas, reach: usize) {
+    if reach == 0 || c.w == 0 || c.h == 0 {
+        return;
+    }
+    let (w, h) = (c.w as usize, c.h as usize);
+    let width = 2 * reach + 1;
+    let mean: Vec<u8> = (0..=255 * width).map(|s| ((s + width / 2) / width) as u8).collect();
+    let clamp = |i: isize, n: usize| i.clamp(0, n as isize - 1) as usize;
+    let mut a = c.data.clone();
+    let mut b = vec![0u8; a.len()];
+    for _ in 0..3 {
+        // Along each row: the running sum of the window either side of the
+        // pixel, past an edge counting the edge pixel again.
+        for y in 0..h {
+            let row = y * w * 4;
+            for ch in 0..4 {
+                let at = |i: usize| a[row + i * 4 + ch] as u32;
+                let mut sum: u32 = (0..width).map(|k| at(clamp(k as isize - reach as isize, w))).sum();
+                for x in 0..w {
+                    b[row + x * 4 + ch] = mean[sum as usize];
+                    sum = sum + at(clamp((x + 1 + reach) as isize, w)) - at(clamp(x as isize - reach as isize, w));
+                }
+            }
+        }
+        // Down each column, a running sum a row at a time.
+        let mut sums = vec![0u32; w * 4];
+        for k in 0..width {
+            let row = clamp(k as isize - reach as isize, h) * w * 4;
+            sums.iter_mut().zip(&b[row..row + w * 4]).for_each(|(s, &v)| *s += v as u32);
+        }
+        for y in 0..h {
+            for i in 0..w * 4 {
+                a[y * w * 4 + i] = mean[sums[i] as usize];
+            }
+            let added = clamp((y + 1 + reach) as isize, h) * w * 4;
+            let taken = clamp(y as isize - reach as isize, h) * w * 4;
+            for i in 0..w * 4 {
+                sums[i] = sums[i] + b[added + i] as u32 - b[taken + i] as u32;
+            }
+        }
+    }
+    c.data.copy_from_slice(&a);
+}
