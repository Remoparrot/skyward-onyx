+    let link_label = l.pick(["从 /sdcard/Download/link.txt 读链接", "從 /sdcard/Download/link.txt 讀取連結", "Read /sdcard/Download/link.txt"]);
+    c.text_center(&f.body, link_label, x, link_y, m.sub_px, t.pal.accent);
+    out.push(Hit { rect: Rect::new(m.margin, link_y - m.dp(18.0), w - m.margin * 2.0, m.dp(36.0)), action: Action::ReadDownloadLink });
+    let kb_top = m.h as f32 - widgets::keyboard_height(t);
