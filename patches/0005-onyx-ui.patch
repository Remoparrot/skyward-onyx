+        if job.ended.is_none() {
+            let r = m.dp(25.0);
+            let cx = m.w as f32 - m.margin - m.dp(31.0);
+            let cy = card_top + m.dp(40.0);
+            c.fill_circle(cx, cy, r, t.pal.accent);
+            if job.paused {
+                let k = r * 0.5;
+                c.line(cx - k * 0.45, cy - k, cx + k * 0.7, cy, m.stroke, Rgba::rgb(255, 255, 255));
+                c.line(cx + k * 0.7, cy, cx - k * 0.45, cy + k, m.stroke, Rgba::rgb(255, 255, 255));
+                c.line(cx - k * 0.45, cy + k, cx - k * 0.45, cy - k, m.stroke, Rgba::rgb(255, 255, 255));
+            } else {
+                let k = r * 0.45;
+                c.line(cx - k * 0.35, cy - k, cx - k * 0.35, cy + k, m.stroke, Rgba::rgb(255, 255, 255));
+                c.line(cx + k * 0.55, cy - k, cx + k * 0.55, cy + k, m.stroke, Rgba::rgb(255, 255, 255));
+            }
+            let action = if job.paused { Action::ResumeDownload } else { Action::PauseDownload };
+            out.push(Hit { rect: Rect::new(cx - r, cy - r, r * 2.0, r * 2.0), action });
+            let stop = widgets::button(&mut c, t, f, bottom + m.card_gap, l.pick(["停止下载", "停止下載", "Stop"]));
