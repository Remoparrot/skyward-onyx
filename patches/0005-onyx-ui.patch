+    /// The data partition is open, and the decrypt page counts three
+    /// seconds before going home by itself.
+    pub fn start_home_countdown(&mut self, now: u64) {
+        if matches!(self.state.data, Data::Open) && self.screen() == Screen::Decrypt {
+            self.home_due = Some(now + 3000);
+            self.state.home_left = 3;
+            self.refresh();
+        }
+    }
+
+    /// Leave the decrypt page for the home page, as the countdown ending
+    /// does.
+    pub(super) fn go_home_from_decrypt(&mut self) {
+        self.home_due = None;
+        self.state.home_left = 0;
+        self.leave(true);
+        if self.stack.len() > 1 {
+            self.stack.pop();
+        } else {
+            *self.top_mut() = (Screen::Home, 0.0, Focus::Unset);
+        }
+        self.settle_page();
+        self.refresh();
+    }
+
+    /// How the URL download has come, as the runtime read it.
+    pub fn download_url_progress(&mut self, progress: Progress, now: u64) {
+        if let Some(job) = &mut self.state.download_job {
+            let done = match progress {
+                Progress::Downloading { done, .. } => done,
+                Progress::Checking { done, .. } => done,
+            };
+            if now > job.last_ms {
+                job.rate = (done.saturating_sub(job.last_done)) * 1000 / (now - job.last_ms);
+            }
+            job.last_ms = now;
+            job.last_done = done;
+            job.progress = Some(progress);
+            self.refresh();
+        }
+    }
+
+    /// How the URL download ended, saved at the path or why not.
+    pub fn download_url_ended(&mut self, ended: Result<String, String>, now: u64) {
+        if let Some(job) = &mut self.state.download_job {
+            job.ended = Some(ended.clone());
+            job.paused = false;
+            job.rate = 0;
+            self.refresh();
+            match ended {
+                Ok(path) => self.say(&format!("已保存到 {path}"), now),
+                Err(why) => self.report(&why, now),
+            }
+        }
+    }
+
+    /// The download was paused or carried on, as the runtime did.
+    pub fn download_url_paused(&mut self, paused: bool) {
+        if let Some(job) = &mut self.state.download_job {
+            job.paused = paused;
+            if paused {
+                job.rate = 0;
+            }
+            self.refresh();
+        }
+    }
