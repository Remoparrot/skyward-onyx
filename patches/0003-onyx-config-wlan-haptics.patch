+impl Sysfs {
+    fn open(activate: &str, cfg: &skyward_config::Haptics) -> Result<Sysfs> {
+        let path = |which: &Option<String>, name: &str| -> Result<PathBuf> {
+            which.as_deref().map(PathBuf::from).with_context(|| format!("[haptics] {name} is needed with activate"))
+        };
+        Ok(Sysfs {
+            activate: PathBuf::from(activate),
+            duration: path(&cfg.duration, "duration")?,
+            effect: path(&cfg.effect, "effect")?,
+            gain: path(&cfg.gain, "gain")?,
+        })
+    }
+
+    /// Play the driver's kept waveform through its own switch, then switch
+    /// it off again: the AW8697 plays for as long as the switch is on.
+    fn play(&self, share: f32, ticks: bool) -> Result<Duration> {
+        let millis = if ticks { 10 } else { 16 };
+        let level = (share.clamp(0.0, 1.0) * 128.0).round() as u32;
+        fs::write(&self.effect, "0").with_context(|| format!("write {}", self.effect.display()))?;
+        fs::write(&self.duration, millis.to_string()).with_context(|| format!("write {}", self.duration.display()))?;
+        fs::write(&self.gain, format!("0x{level:02x}")).with_context(|| format!("write {}", self.gain.display()))?;
+        fs::write(&self.activate, "1").with_context(|| format!("write {}", self.activate.display()))?;
+        let length = Duration::from_millis(millis);
+        std::thread::sleep(length);
+        let _ = fs::write(&self.activate, "0");
+        Ok(length)
+    }
